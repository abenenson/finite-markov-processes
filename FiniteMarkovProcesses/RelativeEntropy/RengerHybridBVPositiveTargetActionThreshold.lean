import
  FiniteMarkovProcesses.RelativeEntropy.RengerHybridBVPositiveTargetGeneratedFlowActionConvergence

/-!
# Dynamic-action and KL thresholds for positive Renger target sources

This module converts generated-flow action convergence into finite expected-action and exact
finite-law KL thresholds for the canonical and reference-perturbed target sources.
-/

namespace FiniteMarkovProcesses.InformationTheory

open Filter _root_.FiniteMarkovProcesses.MeasureTheory Set
open scoped BigOperators ENNReal NNReal Topology

open FiniteMarkovProcesses
open FiniteMarkovProcesses.Probability

universe u

noncomputable section

variable {State : Type u} [Fintype State] [DecidableEq State]
  [MeasurableSpace State] [MeasurableSingletonClass State]
/-- Complete target-density action generated by one canonical positive rate chart. -/
noncomputable def rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
    (generator : FiniteStateMarkovGenerator State)
    {duration : ℝ}
    (path : RengerDirectionalFlowHybridBVPath State duration)
    (index : ℕ) : ENNReal :=
  ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
    ∫⁻ time,
      rengerExtendedPoissonRateCost
        (rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedFlowValue
          generator path index time transition.1.1 transition.1.2)
        (rengerDirectionalFlowHybridBVMeasurableExpectedFlowAt
          generator path time transition.1.1 transition.1.2)
      ∂finiteOpenIntervalVolume duration

/-- The actual finite Markov source action is bounded by the target-density action times the
explicit occupation-density defect factor.  This is the one-sided estimate needed by the LDP
recovery sequence; it compares the genuine source law rather than only its generated target
flow. -/
theorem ofReal_rengerDirectionalFlowHybridBVCanonicalPositiveTargetExpectedPoissonRateAction_le
    (generator : FiniteStateMarkovGenerator State)
    {duration : ℝ} (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (hDynamicRate :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 ≠ ⊤)
    (densityFloor : NNReal) (hDensityFloorPositive : 0 < densityFloor)
    (hDensityFloor : ∀ source,
      ∀ᵐ time ∂finiteOpenIntervalVolume duration,
        densityFloor ≤
          rengerDirectionalFlowHybridBVMeasurableDensityAt path.1 time source)
    (index : ℕ) :
    ENNReal.ofReal
        (finiteStateTimeDependentMarkovExpectedPoissonRateAction
          (rengerDirectionalFlowHybridBVTargetInitialPMF path)
          (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
            generator path.1 index)
          generator.toTimeDependentMarkovRate ⟨duration, hDuration.le⟩) ≤
      ENNReal.ofReal
          (1 +
            2 *
              (rengerDirectionalFlowHybridBVCanonicalPositiveTargetTotalIntegratedFlowDefect
                generator path index).toReal /
              (densityFloor : ℝ)) *
        rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
          generator path.1 index := by
  let rates := rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
    generator path.1 index
  let defect : ENNReal :=
    rengerDirectionalFlowHybridBVCanonicalPositiveTargetTotalIntegratedFlowDefect
      generator path index
  let factor : ℝ := 1 + 2 * defect.toReal / (densityFloor : ℝ)
  have hDefectFinite : defect ≠ ⊤ := by
    exact rengerDirectionalFlowHybridBVCanonicalPositiveTargetTotalIntegratedFlowDefect_ne_top
      generator hDuration path hDynamicRate index
  have hFactorNonnegative : 0 ≤ factor := by
    dsimp only [factor]
    positivity
  unfold finiteStateTimeDependentMarkovExpectedPoissonRateAction
  calc
    ENNReal.ofReal
        (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
          ∫ time,
            (finiteStateTimeDependentMarkovEndpointProbability
                (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                rates time transition.1.1).toReal *
              poissonRateDiscrimination
                (rates.rate time transition.1.1 transition.1.2 : ℝ)
                (generator.rate transition.1.1 transition.1.2 : ℝ)
            ∂finiteOpenIntervalVolume duration) ≤
      ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
        ENNReal.ofReal
          (∫ time,
            (finiteStateTimeDependentMarkovEndpointProbability
                (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                rates time transition.1.1).toReal *
              poissonRateDiscrimination
                (rates.rate time transition.1.1 transition.1.2 : ℝ)
                (generator.rate transition.1.1 transition.1.2 : ℝ)
            ∂finiteOpenIntervalVolume duration) :=
      ofReal_finset_sum_le_sum_ofReal Finset.univ _
    _ ≤ ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
        ENNReal.ofReal factor *
          ∫⁻ time,
            rengerExtendedPoissonRateCost
              (rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedFlowValue
                generator path.1 index time transition.1.1 transition.1.2)
              (rengerDirectionalFlowHybridBVMeasurableExpectedFlowAt
                generator path.1 time transition.1.1 transition.1.2)
            ∂finiteOpenIntervalVolume duration := by
      apply Finset.sum_le_sum
      intro transition _hTransition
      let integrand : ℝ → ℝ := fun time ↦
        (finiteStateTimeDependentMarkovEndpointProbability
            (rengerDirectionalFlowHybridBVTargetInitialPMF path)
            rates time transition.1.1).toReal *
          poissonRateDiscrimination
            (rates.rate time transition.1.1 transition.1.2 : ℝ)
            (generator.rate transition.1.1 transition.1.2 : ℝ)
      calc
        ENNReal.ofReal
            (∫ time, integrand time ∂finiteOpenIntervalVolume duration) ≤
          ∫⁻ time, ENNReal.ofReal (integrand time)
            ∂finiteOpenIntervalVolume duration := by
              by_cases hIntegrable : MeasureTheory.Integrable integrand
                (finiteOpenIntervalVolume duration)
              · exact MeasureTheory.ofReal_integral_le_lintegral_ofReal hIntegrable
              · rw [MeasureTheory.integral_undef hIntegrable, ENNReal.ofReal_zero]
                exact zero_le
        _ ≤ ∫⁻ time,
            ENNReal.ofReal factor *
              rengerExtendedPoissonRateCost
                (rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedFlowValue
                  generator path.1 index time transition.1.1 transition.1.2)
                (rengerDirectionalFlowHybridBVMeasurableExpectedFlowAt
                  generator path.1 time transition.1.1 transition.1.2)
            ∂finiteOpenIntervalVolume duration := by
              apply MeasureTheory.lintegral_mono_ae
              filter_upwards [
                ae_rengerDirectionalFlowHybridBVMeasurableDensityAt_eq path.1,
                path.2.densityNonnegativeAE,
                ae_abs_rengerDirectionalFlowHybridBVCanonicalPositiveTargetDensityError_le_totalDefect
                  generator hDuration path hDynamicRate index transition.1.1,
                hDensityFloor transition.1.1,
                MeasureTheory.ae_restrict_mem measurableSet_Ioo] with
                  time hDensityVersion hDensityNonnegative hDensityError hFloor hTime
              let sourceDensity : ENNReal :=
                finiteStateTimeDependentMarkovEndpointProbability
                  (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                  rates time transition.1.1
              let targetDensity : NNReal :=
                rengerDirectionalFlowHybridBVMeasurableDensityAt
                  path.1 time transition.1.1
              let lawRate : NNReal := rates.rate time transition.1.1 transition.1.2
              let referenceRate : NNReal :=
                generator.rate transition.1.1 transition.1.2
              have hTargetDensityReal :
                  rengerDirectionalFlowHybridBVDensityValue
                      path.1 time transition.1.1 = (targetDensity : ℝ) := by
                calc
                  rengerDirectionalFlowHybridBVDensityValue path.1 time transition.1.1 =
                      (rengerDirectionalFlowHybridBVDensityAt
                        path.1 time transition.1.1 : ℝ) :=
                    (Real.coe_toNNReal _
                      (hDensityNonnegative transition.1.1)).symm
                  _ = (targetDensity : ℝ) := by
                    rw [← congrFun hDensityVersion transition.1.1]
              have hSourceDensityLe : sourceDensity.toReal ≤
                  factor * (targetDensity : ℝ) := by
                have hFloorReal : (densityFloor : ℝ) ≤ (targetDensity : ℝ) := by
                  exact_mod_cast hFloor
                have hErrorUpper : sourceDensity.toReal - (targetDensity : ℝ) ≤
                    2 * defect.toReal := by
                  have := (le_abs_self
                    (rengerDirectionalFlowHybridBVCanonicalPositiveTargetDensityError
                      generator path index time transition.1.1)).trans hDensityError
                  simpa only [rengerDirectionalFlowHybridBVCanonicalPositiveTargetDensityError,
                    rates, sourceDensity, hTargetDensityReal, defect] using this
                have hFloorRealPositive : 0 < (densityFloor : ℝ) := by
                  exact_mod_cast hDensityFloorPositive
                have hScaledError : 2 * defect.toReal ≤
                    (2 * defect.toReal / (densityFloor : ℝ)) *
                      (targetDensity : ℝ) := by
                  rw [div_mul_eq_mul_div]
                  exact (le_div_iff₀ hFloorRealPositive).2 <| by
                    exact mul_le_mul_of_nonneg_left hFloorReal (by positivity)
                dsimp only [factor]
                nlinarith
              have hSourceDensityFinite : sourceDensity ≠ ⊤ := by
                apply ne_top_of_le_ne_top ENNReal.one_ne_top
                have hCoordinate : sourceDensity ≤
                    ∑ observed : State,
                      finiteStateTimeDependentMarkovEndpointProbability
                        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                        rates time observed := by
                  change
                    finiteStateTimeDependentMarkovEndpointProbability
                        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                        rates time transition.1.1 ≤ _
                  exact Finset.single_le_sum
                    (fun observed _hObserved ↦
                      (zero_le : (0 : ENNReal) ≤
                        finiteStateTimeDependentMarkovEndpointProbability
                          (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                          rates time observed))
                    (Finset.mem_univ transition.1.1)
                simpa only [sourceDensity,
                  sum_finiteStateTimeDependentMarkovEndpointProbability
                    (rengerDirectionalFlowHybridBVTargetInitialPMF path)
                    rates time hTime.1.le] using hCoordinate
              have hSourceDensityENNRealLe : sourceDensity ≤
                  ENNReal.ofReal factor * (targetDensity : ENNReal) := by
                rw [← ENNReal.ofReal_toReal hSourceDensityFinite]
                rw [← ENNReal.ofReal_coe_nnreal]
                rw [← ENNReal.ofReal_mul hFactorNonnegative]
                exact ENNReal.ofReal_le_ofReal hSourceDensityLe
              have hRateSupport : lawRate = 0 ↔ referenceRate = 0 := by
                exact
                  rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization_haveSameDirectedSupport
                    generator path.1 index time transition.1.1 transition.1.2
              have hLocalCost :
                  ENNReal.ofReal
                      (poissonRateDiscrimination (lawRate : ℝ) (referenceRate : ℝ)) =
                    rengerExtendedPoissonRateCost lawRate referenceRate :=
                (rengerExtendedPoissonRateCost_eq_ofReal_poissonRateDiscrimination_of_zero_iff
                  lawRate referenceRate hRateSupport).symm
              change ENNReal.ofReal
                  (sourceDensity.toReal *
                    poissonRateDiscrimination (lawRate : ℝ) (referenceRate : ℝ)) ≤ _
              rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg,
                ENNReal.ofReal_toReal]
              · rw [hLocalCost]
                calc
                  sourceDensity * rengerExtendedPoissonRateCost lawRate referenceRate ≤
                      (ENNReal.ofReal factor * (targetDensity : ENNReal)) *
                        rengerExtendedPoissonRateCost lawRate referenceRate := by gcongr
                  _ = ENNReal.ofReal factor *
                      rengerExtendedPoissonRateCost
                        (targetDensity * lawRate) (targetDensity * referenceRate) := by
                    rw [rengerExtendedPoissonRateCost_commonScale]
                    ac_rfl
                  _ = _ := by
                    rfl
              · exact hSourceDensityFinite
        _ = ENNReal.ofReal factor *
            ∫⁻ time,
              rengerExtendedPoissonRateCost
                (rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedFlowValue
                  generator path.1 index time transition.1.1 transition.1.2)
                (rengerDirectionalFlowHybridBVMeasurableExpectedFlowAt
                  generator path.1 time transition.1.1 transition.1.2)
              ∂finiteOpenIntervalVolume duration := by
          rw [MeasureTheory.lintegral_const_mul']
          exact ENNReal.ofReal_ne_top
    _ = ENNReal.ofReal factor *
        rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
          generator path.1 index := by
      unfold rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
      rw [Finset.mul_sum]
    _ = _ := rfl

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- Canonical positive target-generated actions converge to the exact finite hybrid dynamic
rate. -/
theorem tendsto_rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate_atTop
    (generator : FiniteStateMarkovGenerator State)
    {duration : ℝ} (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (hDynamicRate :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 ≠ ⊤) :
    Tendsto
      (rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
        generator path.1)
      atTop
      (nhds (rengerDirectionalFlowHybridBVDynamicRate
        generator hDuration path.1)) := by
  rw [rengerDirectionalFlowHybridBVDynamicRate_eq_sum_measurableTargetRateCostIntegrals
    generator hDuration path]
  unfold rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
  apply tendsto_finsetSum Finset.univ
  intro transition _hTransition
  exact
    tendsto_lintegral_rengerExtendedPoissonRateCost_canonicalPositiveTargetGeneratedFlow_atTop
      generator hDuration path hDynamicRate transition.2

/-- Every action threshold strictly above the finite target dynamic rate eventually contains the
genuine canonical source expected Poisson action.  This is the precise fixed-perturbation
upper-action limit needed by the open-neighborhood recovery argument. -/
theorem
  eventually_ofReal_rengerDirectionalFlowHybridBVCanonicalPositiveTargetExpectedPoissonRateAction_lt
    (generator : FiniteStateMarkovGenerator State)
    {duration : ℝ} (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (hDynamicRate :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 ≠ ⊤)
    (densityFloor : NNReal) (hDensityFloorPositive : 0 < densityFloor)
    (hDensityFloor : ∀ source,
      ∀ᵐ time ∂finiteOpenIntervalVolume duration,
        densityFloor ≤
          rengerDirectionalFlowHybridBVMeasurableDensityAt path.1 time source)
    {actionThreshold : ENNReal}
    (hActionThreshold :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 <
        actionThreshold) :
    ∀ᶠ index : ℕ in atTop,
      ENNReal.ofReal
          (finiteStateTimeDependentMarkovExpectedPoissonRateAction
            (rengerDirectionalFlowHybridBVTargetInitialPMF path)
            (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
              generator path.1 index)
            generator.toTimeDependentMarkovRate ⟨duration, hDuration.le⟩) <
        actionThreshold := by
  let defect : ℕ → ENNReal := fun index ↦
    rengerDirectionalFlowHybridBVCanonicalPositiveTargetTotalIntegratedFlowDefect
      generator path index
  let factor : ℕ → ENNReal := fun index ↦
    ENNReal.ofReal
      (1 + 2 * (defect index).toReal / (densityFloor : ℝ))
  let targetAction : ℕ → ENNReal :=
    rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate
      generator path.1
  have hDefect : Tendsto defect atTop (nhds 0) := by
    exact
      tendsto_rengerDirectionalFlowHybridBVCanonicalPositiveTargetTotalIntegratedFlowDefect_atTop
        generator hDuration path hDynamicRate
  have hDefectReal : Tendsto (fun index ↦ (defect index).toReal) atTop (nhds 0) := by
    exact (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hDefect
  have hFactorReal : Tendsto
      (fun index ↦ 1 + 2 * (defect index).toReal / (densityFloor : ℝ))
      atTop (nhds 1) := by
    have hScaled : Tendsto
        (fun index ↦ 2 * (defect index).toReal / (densityFloor : ℝ))
        atTop (nhds 0) := by
      simpa only [mul_zero, zero_div] using
        (tendsto_const_nhds.mul hDefectReal).div_const (densityFloor : ℝ)
    simpa only [add_zero] using tendsto_const_nhds.add hScaled
  have hFactor : Tendsto factor atTop (nhds 1) := by
    simpa only [factor, ENNReal.ofReal_one] using ENNReal.tendsto_ofReal hFactorReal
  have hTargetAction : Tendsto targetAction atTop
      (nhds (rengerDirectionalFlowHybridBVDynamicRate
        generator hDuration path.1)) := by
    exact
      tendsto_rengerDirectionalFlowHybridBVCanonicalPositiveTargetGeneratedDynamicRate_atTop
        generator hDuration path hDynamicRate
  have hUpper : Tendsto (fun index ↦ factor index * targetAction index) atTop
      (nhds (rengerDirectionalFlowHybridBVDynamicRate
        generator hDuration path.1)) := by
    simpa only [one_mul] using
      ENNReal.Tendsto.mul hFactor (Or.inl one_ne_zero) hTargetAction
        (Or.inr ENNReal.one_ne_top)
  have hEventuallyUpper : ∀ᶠ index : ℕ in atTop,
      factor index * targetAction index < actionThreshold :=
    hUpper.eventually (eventually_lt_nhds hActionThreshold)
  filter_upwards [hEventuallyUpper] with index hIndex
  exact
    (ofReal_rengerDirectionalFlowHybridBVCanonicalPositiveTargetExpectedPoissonRateAction_le
      generator hDuration path hDynamicRate densityFloor hDensityFloorPositive hDensityFloor
      index).trans_lt hIndex

/-- The exact finite canonical relative entropy obeys the same eventual target-action ceiling.
The candidate and reference remain the normalized reduced physical history laws with their
common target initial PMF. -/
theorem eventually_klDiv_rengerDirectionalFlowHybridBVCanonicalPositiveTarget_lt
    (generator : FiniteStateMarkovGenerator State)
    {duration : ℝ} (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (hDynamicRate :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 ≠ ⊤)
    (densityFloor : NNReal) (hDensityFloorPositive : 0 < densityFloor)
    (hDensityFloor : ∀ source,
      ∀ᵐ time ∂finiteOpenIntervalVolume duration,
        densityFloor ≤
          rengerDirectionalFlowHybridBVMeasurableDensityAt path.1 time source)
    {actionThreshold : ENNReal}
    (hActionThreshold :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 <
        actionThreshold) :
    ∀ᶠ index : ℕ in atTop,
      let rates :=
        rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
          generator path.1 index
      let candidate := finiteStateTimeDependentMarkovReducedHistoryMeasure
        (rengerDirectionalFlowHybridBVTargetInitialPMF path) rates
        ⟨duration, hDuration.le⟩
      let reference := finiteStateTimeDependentMarkovReducedHistoryMeasure
        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
        generator.toTimeDependentMarkovRate ⟨duration, hDuration.le⟩
      _root_.InformationTheory.klDiv candidate reference < actionThreshold := by
  have hEventually :=
    eventually_ofReal_rengerDirectionalFlowHybridBVCanonicalPositiveTargetExpectedPoissonRateAction_lt
      generator hDuration path hDynamicRate densityFloor hDensityFloorPositive hDensityFloor
      hActionThreshold
  filter_upwards [hEventually] with index hIndex
  dsimp only
  have hExpectation :=
    rengerDirectionalFlowHybridBVCanonicalPositiveTargetExpectedJumpLogAction_eq_klDiv
      generator hDuration path index
        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
  have hPoisson :=
    rengerDirectionalFlowHybridBVCanonicalPositiveTargetExpectedJumpLogAction_eq_expectedPoissonRateAction
      generator hDuration path index
        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
  rw [← ENNReal.ofReal_toReal hExpectation.1]
  rw [← hExpectation.2, hPoisson]
  exact hIndex

/-- Every strictly positive reference-evolution perturbation has a genuine uniform finite-state
density floor, so its canonical finite relative entropies eventually lie below every threshold
strictly above the perturbed dynamic rate. -/
theorem eventually_klDiv_rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedTarget_lt
    [Nonempty State]
    (generator : FiniteStateMarkovGenerator State)
    {duration : ℝ} (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (hDynamicRate :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 ≠ ⊤)
    (mixingWeight : NNReal) (hMixingWeight : 0 < mixingWeight)
    (hMixingWeightLeOne : mixingWeight ≤ 1)
    (hInitial : ∀ state,
      0 < rengerDirectionalFlowHybridBVInitialDensity path.1 state)
    {actionThreshold : ENNReal}
    (hActionThreshold :
      let perturbed :=
        rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedRepresentationPath
          generator path mixingWeight mixingWeight.coe_nonneg hMixingWeightLeOne
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration perturbed.1 <
        actionThreshold) :
    let perturbed :=
      rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedRepresentationPath
        generator path mixingWeight mixingWeight.coe_nonneg hMixingWeightLeOne
    ∀ᶠ index : ℕ in atTop,
      let rates :=
        rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
          generator perturbed.1 index
      let candidate := finiteStateTimeDependentMarkovReducedHistoryMeasure
        (rengerDirectionalFlowHybridBVTargetInitialPMF perturbed) rates
        ⟨duration, hDuration.le⟩
      let reference := finiteStateTimeDependentMarkovReducedHistoryMeasure
        (rengerDirectionalFlowHybridBVTargetInitialPMF perturbed)
        generator.toTimeDependentMarkovRate ⟨duration, hDuration.le⟩
      _root_.InformationTheory.klDiv candidate reference < actionThreshold := by
  dsimp only
  let perturbed :=
    rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedRepresentationPath
      generator path mixingWeight mixingWeight.coe_nonneg hMixingWeightLeOne
  let stateFloor : State → NNReal := fun state ↦
    rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityFloor
      generator path mixingWeight state
  let uniformFloor : NNReal :=
    Finset.univ.inf' Finset.univ_nonempty stateFloor
  have hStateFloorPositive (state : State) : 0 < stateFloor state := by
    exact
      rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityFloor_pos
        generator path mixingWeight hMixingWeight state (hInitial state)
  have hUniformFloorPositive : 0 < uniformFloor := by
    change 0 < Finset.univ.inf' Finset.univ_nonempty stateFloor
    rw [Finset.lt_inf'_iff]
    intro state _hState
    exact hStateFloorPositive state
  have hUniformFloor (state : State) :
      ∀ᵐ time ∂finiteOpenIntervalVolume duration,
        uniformFloor ≤
          rengerDirectionalFlowHybridBVMeasurableDensityAt perturbed.1 time state := by
    filter_upwards [
      ae_rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityFloor_le
        generator path mixingWeight hMixingWeightLeOne state] with time hFloor
    exact (Finset.inf'_le stateFloor (Finset.mem_univ state)).trans hFloor
  have hPerturbedDynamicRate :
      rengerDirectionalFlowHybridBVDynamicRate generator hDuration perturbed.1 ≠ ⊤ := by
    have hUpper :=
      rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedPath_dynamicRate_le
        generator path mixingWeight hMixingWeightLeOne
    have hFinite :
        ((1 - mixingWeight : NNReal) : ENNReal) *
            rengerDirectionalFlowHybridBVDynamicRate generator hDuration path.1 ≠ ⊤ :=
      ENNReal.mul_ne_top ENNReal.coe_ne_top hDynamicRate
    exact ne_top_of_le_ne_top hFinite hUpper
  exact
    eventually_klDiv_rengerDirectionalFlowHybridBVCanonicalPositiveTarget_lt
      generator hDuration perturbed hPerturbedDynamicRate uniformFloor
      hUniformFloorPositive hUniformFloor hActionThreshold

end


end FiniteMarkovProcesses.InformationTheory
