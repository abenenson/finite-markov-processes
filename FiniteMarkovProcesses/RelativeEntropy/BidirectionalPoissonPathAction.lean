module
public import FiniteMarkovProcesses.RelativeEntropy.BidirectionalPoissonAction
public import FiniteMarkovProcesses.RelativeEntropy.PoissonMeasureDiscrimination
public import MeasureDiscrimination.ProductDiscrimination
public import FiniteMarkovProcesses.Probability.DrivenPoissonCycleHistory
public import FiniteMarkovProcesses.Probability.PoissonCountExpectation

/-!
# Bidirectional Poisson path-action sectors

This file derives the exact count-skeleton log density between two complete driven-cycle history
laws. The density is integrable and its expectation is the bidirectional Poisson discrimination.
Under registered-history reversal it splits into an antisymmetric excess-affinity sector and a
symmetric escape/traffic sector.

The theorems use the Poisson marginal likelihood ratios and the common conditional state/tape
law to identify the action and its expectation.

## Main results

- `bidirectionalPoissonCountLogLikelihoodRatio_affine`: exact count-density formula.
- `llr_bidirectionalPoissonHistoryMeasure`: identification with the complete-history likelihood.
- `toReal_klDiv_bidirectionalPoissonHistoryMeasure`: exact complete-history relative entropy.
- `integral_bidirectionalPoissonCountLogLikelihoodRatio`: exact mean relative action.
- `bidirectionalPoissonAntisymmetricSector_eq_affinityExcess`: antisymmetric closed form.
- `bidirectionalPoissonSymmetricSector_eq`: symmetric escape/traffic closed form.
- `bidirectionalPoissonCountLogLikelihoodRatio_decomposition`: exact sector decomposition.
- `physicalPoissonCountLogDensity_eq_current_mul_affinity`: physical reversal density.
- `integral_physicalPoissonCountLogDensity`: mean entropy-action formula.
-/

@[expose] public section

namespace FiniteMarkovProcesses.InformationTheory

open Function MeasureTheory ProbabilityTheory
open _root_.InformationTheory
open scoped ENNReal NNReal

open FiniteMarkovProcesses.Probability

/-- A pair of nonnegative integrated Poisson intensities used by actual count measures. -/
@[ext]
structure BidirectionalPoissonNNRates where
  /-- Nonnegative integrated clockwise Poisson intensity. -/
  clockwise : ℝ≥0
  /-- Nonnegative integrated counterclockwise Poisson intensity. -/
  counterclockwise : ℝ≥0

namespace BidirectionalPoissonNNRates

/-- Both actual Poisson intensities are strictly positive. -/
def Positive (rates : BidirectionalPoissonNNRates) : Prop :=
  0 < rates.clockwise ∧ 0 < rates.counterclockwise

/-- Convert nonnegative intensities to the real-valued algebraic classifier. -/
def toRealRates (rates : BidirectionalPoissonNNRates) : BidirectionalPoissonRates where
  clockwise := rates.clockwise
  counterclockwise := rates.counterclockwise

/-- Exchange clockwise and counterclockwise intensities. -/
def swap (rates : BidirectionalPoissonNNRates) : BidirectionalPoissonNNRates where
  clockwise := rates.counterclockwise
  counterclockwise := rates.clockwise

/-- Positivity is preserved by exchanging the directional intensities. -/
theorem swap_positive {rates : BidirectionalPoissonNNRates} (hRates : rates.Positive) :
    rates.swap.Positive :=
  ⟨hRates.2, hRates.1⟩

/-- Positive nonnegative intensities remain positive after conversion to real rates. -/
theorem toRealRates_positive
    {rates : BidirectionalPoissonNNRates} (hRates : rates.Positive) :
    rates.toRealRates.Positive :=
  ⟨by exact_mod_cast hRates.1, by exact_mod_cast hRates.2⟩

/-- Conversion to real rates commutes with exchanging directions. -/
@[simp]
theorem swap_toRealRates (rates : BidirectionalPoissonNNRates) :
    rates.swap.toRealRates =
      ⟨rates.toRealRates.counterclockwise, rates.toRealRates.clockwise⟩ := rfl

end BidirectionalPoissonNNRates

/-- Complete history law generated by a directional nonnegative rate pair. -/
noncomputable def bidirectionalPoissonHistoryMeasure
    (rates : BidirectionalPoissonNNRates) : Measure DrivenCycleHistory :=
  drivenCycleHistoryMeasure rates.clockwise rates.counterclockwise

/-- The complete bidirectional history law is normalized at the given nonnegative intensities. -/
noncomputable instance instIsProbabilityMeasureBidirectionalPoissonHistoryMeasure
    (rates : BidirectionalPoissonNNRates) :
    IsProbabilityMeasure (bidirectionalPoissonHistoryMeasure rates) := by
  unfold bidirectionalPoissonHistoryMeasure
  infer_instance

/-- Every positive-reference directional count law dominates every directional count law. -/
theorem drivenCycleCountMeasure_absolutelyContinuous
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hReference : referenceRates.Positive) :
    drivenCycleCountMeasure lawRates.clockwise lawRates.counterclockwise ≪
      drivenCycleCountMeasure referenceRates.clockwise referenceRates.counterclockwise := by
  unfold drivenCycleCountMeasure
  exact MeasureDiscrimination.prod_absolutelyContinuous
    (poissonMeasure lawRates.clockwise) (poissonMeasure referenceRates.clockwise)
    (poissonMeasure lawRates.counterclockwise)
    (poissonMeasure referenceRates.counterclockwise)
    (by
      simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
        (pmfToMeasure_absolutelyContinuous (poissonCountPMF lawRates.clockwise)
          (poissonCountPMF referenceRates.clockwise) (poissonPMF_ne_zero hReference.1)))
    (by
      simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
        (pmfToMeasure_absolutelyContinuous (poissonCountPMF lawRates.counterclockwise)
          (poissonCountPMF referenceRates.counterclockwise) (poissonPMF_ne_zero hReference.2)))

/-- Every positive-reference complete driven-cycle law dominates every directional law. -/
theorem bidirectionalPoissonHistoryMeasure_absolutelyContinuous
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hReference : referenceRates.Positive) :
    bidirectionalPoissonHistoryMeasure lawRates ≪
      bidirectionalPoissonHistoryMeasure referenceRates := by
  unfold bidirectionalPoissonHistoryMeasure drivenCycleHistoryMeasure
  exact MeasureDiscrimination.prod_absolutelyContinuous_common_right _ _ _
    (drivenCycleCountMeasure_absolutelyContinuous
      (lawRates := lawRates) (referenceRates := referenceRates) hReference)

/-- Real-valued net registered directional count. -/
def drivenCycleOrientedCount (history : DrivenCycleHistory) : ℝ :=
  history.clockwiseCount - history.counterclockwiseCount

/-- Real-valued total registered contact count. -/
def drivenCycleTotalCount (history : DrivenCycleHistory) : ℝ :=
  history.clockwiseCount + history.counterclockwiseCount

/-- Reversal negates the oriented count. -/
@[simp]
theorem drivenCycleOrientedCount_reversal (history : DrivenCycleHistory) :
    drivenCycleOrientedCount (drivenCycleHistoryReversal history) =
      -drivenCycleOrientedCount history := by
  simp [drivenCycleOrientedCount]

/-- Reversal preserves the total contact count. -/
@[simp]
theorem drivenCycleTotalCount_reversal (history : DrivenCycleHistory) :
    drivenCycleTotalCount (drivenCycleHistoryReversal history) =
      drivenCycleTotalCount history := by
  simp [drivenCycleTotalCount, add_comm]

/-- The clockwise count is integrable under every complete directional history law. -/
theorem integrable_drivenCycleClockwiseCount (rates : BidirectionalPoissonNNRates) :
    Integrable (fun history : DrivenCycleHistory ↦ (history.clockwiseCount : ℝ))
      (bidirectionalPoissonHistoryMeasure rates) := by
  have hMapped : Integrable (fun count : ℕ ↦ (count : ℝ))
      (Measure.map DrivenCycleHistory.clockwiseCount
        (bidirectionalPoissonHistoryMeasure rates)) := by
    rw [bidirectionalPoissonHistoryMeasure,
      drivenCycleHistoryMeasure_clockwiseCountMarginal]
    exact integrable_poissonCount rates.clockwise
  simpa [Function.comp_def] using
    hMapped.comp_aemeasurable measurable_drivenCycleClockwiseCount.aemeasurable

/-- The counterclockwise count is integrable under every complete directional history law. -/
theorem integrable_drivenCycleCounterclockwiseCount
    (rates : BidirectionalPoissonNNRates) :
    Integrable (fun history : DrivenCycleHistory ↦ (history.counterclockwiseCount : ℝ))
      (bidirectionalPoissonHistoryMeasure rates) := by
  have hMapped : Integrable (fun count : ℕ ↦ (count : ℝ))
      (Measure.map DrivenCycleHistory.counterclockwiseCount
        (bidirectionalPoissonHistoryMeasure rates)) := by
    rw [bidirectionalPoissonHistoryMeasure,
      drivenCycleHistoryMeasure_counterclockwiseCountMarginal]
    exact integrable_poissonCount rates.counterclockwise
  simpa [Function.comp_def] using
    hMapped.comp_aemeasurable measurable_drivenCycleCounterclockwiseCount.aemeasurable

/-- The expected clockwise count equals the clockwise integrated intensity. -/
theorem integral_drivenCycleClockwiseCount (rates : BidirectionalPoissonNNRates) :
    ∫ history : DrivenCycleHistory, (history.clockwiseCount : ℝ)
        ∂bidirectionalPoissonHistoryMeasure rates =
      (rates.clockwise : ℝ) := by
  calc
    _ = ∫ count : ℕ, (count : ℝ)
        ∂Measure.map DrivenCycleHistory.clockwiseCount
          (bidirectionalPoissonHistoryMeasure rates) := by
      symm
      exact integral_map measurable_drivenCycleClockwiseCount.aemeasurable
        (measurable_of_countable (fun count : ℕ ↦ (count : ℝ))).aestronglyMeasurable
    _ = ∫ count : ℕ, (count : ℝ) ∂poissonMeasure rates.clockwise := by
      rw [bidirectionalPoissonHistoryMeasure,
        drivenCycleHistoryMeasure_clockwiseCountMarginal]
    _ = (rates.clockwise : ℝ) := integral_poissonCount rates.clockwise

/-- The expected counterclockwise count equals its integrated intensity. -/
theorem integral_drivenCycleCounterclockwiseCount
    (rates : BidirectionalPoissonNNRates) :
    ∫ history : DrivenCycleHistory, (history.counterclockwiseCount : ℝ)
        ∂bidirectionalPoissonHistoryMeasure rates =
      (rates.counterclockwise : ℝ) := by
  calc
    _ = ∫ count : ℕ, (count : ℝ)
        ∂Measure.map DrivenCycleHistory.counterclockwiseCount
          (bidirectionalPoissonHistoryMeasure rates) := by
      symm
      exact integral_map measurable_drivenCycleCounterclockwiseCount.aemeasurable
        (measurable_of_countable (fun count : ℕ ↦ (count : ℝ))).aestronglyMeasurable
    _ = ∫ count : ℕ, (count : ℝ) ∂poissonMeasure rates.counterclockwise := by
      rw [bidirectionalPoissonHistoryMeasure,
        drivenCycleHistoryMeasure_counterclockwiseCountMarginal]
    _ = (rates.counterclockwise : ℝ) := integral_poissonCount rates.counterclockwise

/-- The oriented count is integrable. -/
theorem integrable_drivenCycleOrientedCount (rates : BidirectionalPoissonNNRates) :
    Integrable drivenCycleOrientedCount (bidirectionalPoissonHistoryMeasure rates) := by
  exact (integrable_drivenCycleClockwiseCount rates).sub
    (integrable_drivenCycleCounterclockwiseCount rates)

/-- The total count is integrable. -/
theorem integrable_drivenCycleTotalCount (rates : BidirectionalPoissonNNRates) :
    Integrable drivenCycleTotalCount (bidirectionalPoissonHistoryMeasure rates) := by
  exact (integrable_drivenCycleClockwiseCount rates).add
    (integrable_drivenCycleCounterclockwiseCount rates)

/-- The expected oriented count is the directional current. -/
theorem integral_drivenCycleOrientedCount (rates : BidirectionalPoissonNNRates) :
    ∫ history, drivenCycleOrientedCount history ∂bidirectionalPoissonHistoryMeasure rates =
      rates.toRealRates.current := by
  change (∫ history, (history.clockwiseCount : ℝ) - history.counterclockwiseCount
      ∂bidirectionalPoissonHistoryMeasure rates) = rates.toRealRates.current
  rw [integral_sub (integrable_drivenCycleClockwiseCount rates)
      (integrable_drivenCycleCounterclockwiseCount rates),
    integral_drivenCycleClockwiseCount, integral_drivenCycleCounterclockwiseCount]
  rfl

/-- The expected total count is the directional traffic. -/
theorem integral_drivenCycleTotalCount (rates : BidirectionalPoissonNNRates) :
    ∫ history, drivenCycleTotalCount history ∂bidirectionalPoissonHistoryMeasure rates =
      rates.toRealRates.traffic := by
  change (∫ history, (history.clockwiseCount : ℝ) + history.counterclockwiseCount
      ∂bidirectionalPoissonHistoryMeasure rates) = rates.toRealRates.traffic
  rw [integral_add (integrable_drivenCycleClockwiseCount rates)
      (integrable_drivenCycleCounterclockwiseCount rates),
    integral_drivenCycleClockwiseCount, integral_drivenCycleCounterclockwiseCount]
  rfl

/-- Exact sum of the two actual Poisson marginal log likelihood ratios. -/
noncomputable def bidirectionalPoissonCountLogLikelihoodRatio
    (lawRates referenceRates : BidirectionalPoissonNNRates)
    (history : DrivenCycleHistory) : ℝ :=
  Real.log
      ((poissonCountPMF lawRates.clockwise history.clockwiseCount /
        poissonCountPMF referenceRates.clockwise history.clockwiseCount).toReal) +
    Real.log
      ((poissonCountPMF lawRates.counterclockwise history.counterclockwiseCount /
        poissonCountPMF referenceRates.counterclockwise history.counterclockwiseCount).toReal)

/-- The actual bidirectional count log density is affine in the two registered counts. -/
theorem bidirectionalPoissonCountLogLikelihoodRatio_affine
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates history =
      referenceRates.toRealRates.traffic - lawRates.toRealRates.traffic +
        (history.clockwiseCount : ℝ) *
          Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
        (history.counterclockwiseCount : ℝ) *
          Real.log ((lawRates.counterclockwise : ℝ) /
            referenceRates.counterclockwise) := by
  unfold bidirectionalPoissonCountLogLikelihoodRatio
  rw [poissonLogLikelihoodRatio hLaw.1 hReference.1,
    poissonLogLikelihoodRatio hLaw.2 hReference.2]
  unfold BidirectionalPoissonNNRates.toRealRates BidirectionalPoissonRates.traffic
  ring

/-- The complete-law count log density is integrable under its law. -/
theorem integrable_bidirectionalPoissonCountLogLikelihoodRatio
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    Integrable (bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates)
      (bidirectionalPoissonHistoryMeasure lawRates) := by
  have hFunction :
      bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates =
        fun history ↦
          referenceRates.toRealRates.traffic - lawRates.toRealRates.traffic +
            (history.clockwiseCount : ℝ) *
              Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
            (history.counterclockwiseCount : ℝ) *
              Real.log ((lawRates.counterclockwise : ℝ) /
                referenceRates.counterclockwise) := by
    funext history
    exact bidirectionalPoissonCountLogLikelihoodRatio_affine hLaw hReference history
  rw [hFunction]
  exact ((integrable_const _).add
    ((integrable_drivenCycleClockwiseCount lawRates).mul_const _)).add
      ((integrable_drivenCycleCounterclockwiseCount lawRates).mul_const _)

/-- The mean complete-law count action is the bidirectional Poisson discrimination. -/
theorem integral_bidirectionalPoissonCountLogLikelihoodRatio
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    ∫ history, bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates history
        ∂bidirectionalPoissonHistoryMeasure lawRates =
      bidirectionalPoissonDiscrimination lawRates.toRealRates
        referenceRates.toRealRates := by
  have hFunction :
      bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates =
        fun history ↦
          referenceRates.toRealRates.traffic - lawRates.toRealRates.traffic +
            (history.clockwiseCount : ℝ) *
              Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
            (history.counterclockwiseCount : ℝ) *
              Real.log ((lawRates.counterclockwise : ℝ) /
                referenceRates.counterclockwise) := by
    funext history
    exact bidirectionalPoissonCountLogLikelihoodRatio_affine hLaw hReference history
  rw [hFunction]
  change (∫ history,
      (referenceRates.toRealRates.traffic - lawRates.toRealRates.traffic +
        (history.clockwiseCount : ℝ) *
          Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise)) +
        (history.counterclockwiseCount : ℝ) *
          Real.log ((lawRates.counterclockwise : ℝ) /
            referenceRates.counterclockwise)
      ∂bidirectionalPoissonHistoryMeasure lawRates) = _
  calc
    _ = (∫ history,
          referenceRates.toRealRates.traffic - lawRates.toRealRates.traffic +
            (history.clockwiseCount : ℝ) *
              Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise)
          ∂bidirectionalPoissonHistoryMeasure lawRates) +
        ∫ history, (history.counterclockwiseCount : ℝ) *
            Real.log ((lawRates.counterclockwise : ℝ) /
              referenceRates.counterclockwise)
          ∂bidirectionalPoissonHistoryMeasure lawRates :=
      integral_add
        ((integrable_const _).add
          ((integrable_drivenCycleClockwiseCount lawRates).mul_const _))
        ((integrable_drivenCycleCounterclockwiseCount lawRates).mul_const _)
    _ = ((∫ _history,
          referenceRates.toRealRates.traffic - lawRates.toRealRates.traffic
          ∂bidirectionalPoissonHistoryMeasure lawRates) +
        ∫ history, (history.clockwiseCount : ℝ) *
            Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise)
          ∂bidirectionalPoissonHistoryMeasure lawRates) +
        ∫ history, (history.counterclockwiseCount : ℝ) *
            Real.log ((lawRates.counterclockwise : ℝ) /
              referenceRates.counterclockwise)
          ∂bidirectionalPoissonHistoryMeasure lawRates := by
      rw [integral_add (integrable_const _)
        ((integrable_drivenCycleClockwiseCount lawRates).mul_const _)]
    _ = bidirectionalPoissonDiscrimination lawRates.toRealRates
        referenceRates.toRealRates := by
      rw [integral_const, integral_mul_const, integral_mul_const,
        integral_drivenCycleClockwiseCount, integral_drivenCycleCounterclockwiseCount]
      simp only [probReal_univ, one_smul]
      unfold bidirectionalPoissonDiscrimination poissonRateDiscrimination
      unfold BidirectionalPoissonNNRates.toRealRates BidirectionalPoissonRates.traffic
      ring

/-- The likelihood ratio of the directional count pair is the sum of the two Poisson marginal
log likelihoods. -/
theorem llr_drivenCycleCountMeasure
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hReference : referenceRates.Positive) :
    llr
        (drivenCycleCountMeasure lawRates.clockwise lawRates.counterclockwise)
        (drivenCycleCountMeasure referenceRates.clockwise referenceRates.counterclockwise) =ᵐ[
      drivenCycleCountMeasure lawRates.clockwise lawRates.counterclockwise]
      fun counts : ℕ × ℕ ↦
        Real.log
          ((poissonCountPMF lawRates.clockwise counts.1 /
            poissonCountPMF referenceRates.clockwise counts.1).toReal) +
        Real.log
          ((poissonCountPMF lawRates.counterclockwise counts.2 /
            poissonCountPMF referenceRates.counterclockwise counts.2).toReal) := by
  have hClockwiseAC :
      poissonMeasure lawRates.clockwise ≪ poissonMeasure referenceRates.clockwise := by
    simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
      (pmfToMeasure_absolutelyContinuous (poissonCountPMF lawRates.clockwise)
        (poissonCountPMF referenceRates.clockwise) (poissonPMF_ne_zero hReference.1))
  have hCounterclockwiseAC :
      poissonMeasure lawRates.counterclockwise ≪
        poissonMeasure referenceRates.counterclockwise := by
    simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
      (pmfToMeasure_absolutelyContinuous (poissonCountPMF lawRates.counterclockwise)
        (poissonCountPMF referenceRates.counterclockwise) (poissonPMF_ne_zero hReference.2))
  have hProduct := MeasureDiscrimination.llr_prod
    (poissonMeasure lawRates.clockwise) (poissonMeasure referenceRates.clockwise)
    (poissonMeasure lawRates.counterclockwise)
    (poissonMeasure referenceRates.counterclockwise)
    hClockwiseAC hCounterclockwiseAC
  have hClockwise := MeasureDiscrimination.ae_comp_fst_of_ae
    (poissonMeasure lawRates.clockwise)
    (poissonMeasure lawRates.counterclockwise)
    (by
      simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
        (llr_pmfToMeasure (poissonCountPMF lawRates.clockwise)
          (poissonCountPMF referenceRates.clockwise) (poissonPMF_ne_zero hReference.1)))
  have hCounterclockwise := MeasureDiscrimination.ae_comp_snd_of_ae
    (poissonMeasure lawRates.clockwise)
    (poissonMeasure lawRates.counterclockwise)
    (by
      simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
        (llr_pmfToMeasure (poissonCountPMF lawRates.counterclockwise)
          (poissonCountPMF referenceRates.counterclockwise) (poissonPMF_ne_zero hReference.2)))
  unfold drivenCycleCountMeasure
  filter_upwards [hProduct, hClockwise, hCounterclockwise] with counts
      hproduct hclockwise hcounterclockwise
  rw [hproduct]
  simpa only [poissonMeasure_eq_poissonCountPMF_toMeasure] using
    congrArg₂ (· + ·) hclockwise hcounterclockwise

/-- The explicit count action is the log-likelihood ratio of the complete registered history
laws. The common state/tape apparatus contributes zero discrimination. -/
theorem llr_bidirectionalPoissonHistoryMeasure
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hReference : referenceRates.Positive) :
    llr (bidirectionalPoissonHistoryMeasure lawRates)
        (bidirectionalPoissonHistoryMeasure referenceRates) =ᵐ[
      bidirectionalPoissonHistoryMeasure lawRates]
      bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates := by
  have hCountAC := drivenCycleCountMeasure_absolutelyContinuous
    (lawRates := lawRates) (referenceRates := referenceRates) hReference
  have hFull := MeasureDiscrimination.llr_prod_common_right
    (drivenCycleCountMeasure lawRates.clockwise lawRates.counterclockwise)
    (drivenCycleCountMeasure referenceRates.clockwise referenceRates.counterclockwise)
    drivenCycleConditionalMeasure hCountAC
  have hCount := MeasureDiscrimination.ae_comp_fst_of_ae
    (drivenCycleCountMeasure lawRates.clockwise lawRates.counterclockwise)
    drivenCycleConditionalMeasure
    (llr_drivenCycleCountMeasure
      (lawRates := lawRates) (referenceRates := referenceRates) hReference)
  unfold bidirectionalPoissonHistoryMeasure drivenCycleHistoryMeasure
  filter_upwards [hFull, hCount] with history hfull hcount
  rw [hfull, hcount]
  rfl

/-- The complete-history log-likelihood ratio is integrable for positive directional laws. -/
theorem integrable_llr_bidirectionalPoissonHistoryMeasure
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    Integrable
      (llr (bidirectionalPoissonHistoryMeasure lawRates)
        (bidirectionalPoissonHistoryMeasure referenceRates))
      (bidirectionalPoissonHistoryMeasure lawRates) := by
  rw [integrable_congr
    (llr_bidirectionalPoissonHistoryMeasure
      (lawRates := lawRates) (referenceRates := referenceRates) hReference)]
  exact integrable_bidirectionalPoissonCountLogLikelihoodRatio hLaw hReference

/-- Complete-history KL is exactly the bidirectional Poisson discrimination. -/
theorem toReal_klDiv_bidirectionalPoissonHistoryMeasure
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    (klDiv (bidirectionalPoissonHistoryMeasure lawRates)
      (bidirectionalPoissonHistoryMeasure referenceRates)).toReal =
      bidirectionalPoissonDiscrimination lawRates.toRealRates
        referenceRates.toRealRates := by
  rw [toReal_klDiv
    (bidirectionalPoissonHistoryMeasure_absolutelyContinuous
      (lawRates := lawRates) (referenceRates := referenceRates) hReference)
    (integrable_llr_bidirectionalPoissonHistoryMeasure hLaw hReference),
    integral_congr_ae
    (llr_bidirectionalPoissonHistoryMeasure
      (lawRates := lawRates) (referenceRates := referenceRates) hReference)]
  simpa only [probReal_univ, add_sub_cancel_right] using
    integral_bidirectionalPoissonCountLogLikelihoodRatio hLaw hReference

/-- Time-antisymmetric part of the relative count action under registered reversal. -/
noncomputable def bidirectionalPoissonAntisymmetricSector
    (lawRates referenceRates : BidirectionalPoissonNNRates)
    (history : DrivenCycleHistory) : ℝ :=
  (bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates history -
    bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates
      (drivenCycleHistoryReversal history)) / 2

/-- Time-symmetric part of the relative count action under registered reversal. -/
noncomputable def bidirectionalPoissonSymmetricSector
    (lawRates referenceRates : BidirectionalPoissonNNRates)
    (history : DrivenCycleHistory) : ℝ :=
  (bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates history +
    bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates
      (drivenCycleHistoryReversal history)) / 2

/-- The relative count action is exactly the sum of its two reversal sectors. -/
theorem bidirectionalPoissonCountLogLikelihoodRatio_decomposition
    (lawRates referenceRates : BidirectionalPoissonNNRates)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonCountLogLikelihoodRatio lawRates referenceRates history =
      bidirectionalPoissonAntisymmetricSector lawRates referenceRates history +
        bidirectionalPoissonSymmetricSector lawRates referenceRates history := by
  unfold bidirectionalPoissonAntisymmetricSector bidirectionalPoissonSymmetricSector
  ring

/-- The antisymmetric sector changes sign under registered reversal. -/
theorem bidirectionalPoissonAntisymmetricSector_reversal
    (lawRates referenceRates : BidirectionalPoissonNNRates)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonAntisymmetricSector lawRates referenceRates
        (drivenCycleHistoryReversal history) =
      -bidirectionalPoissonAntisymmetricSector lawRates referenceRates history := by
  unfold bidirectionalPoissonAntisymmetricSector
  rw [drivenCycleHistoryReversal_involutive history]
  ring

/-- The symmetric sector is invariant under registered reversal. -/
theorem bidirectionalPoissonSymmetricSector_reversal
    (lawRates referenceRates : BidirectionalPoissonNNRates)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonSymmetricSector lawRates referenceRates
        (drivenCycleHistoryReversal history) =
      bidirectionalPoissonSymmetricSector lawRates referenceRates history := by
  unfold bidirectionalPoissonSymmetricSector
  rw [drivenCycleHistoryReversal_involutive history]
  ring

/-- The antisymmetric sector is oriented count paired with two log-rate changes. -/
theorem bidirectionalPoissonAntisymmetricSector_eq_logRateDifference
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonAntisymmetricSector lawRates referenceRates history =
      drivenCycleOrientedCount history / 2 *
        (Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) -
          Real.log ((lawRates.counterclockwise : ℝ) /
            referenceRates.counterclockwise)) := by
  unfold bidirectionalPoissonAntisymmetricSector
  rw [bidirectionalPoissonCountLogLikelihoodRatio_affine hLaw hReference,
    bidirectionalPoissonCountLogLikelihoodRatio_affine hLaw hReference]
  simp only [drivenCycleHistoryReversal_clockwiseCount,
    drivenCycleHistoryReversal_counterclockwiseCount]
  unfold drivenCycleOrientedCount
  ring

/-- The antisymmetric sector is half current paired with excess directional affinity. -/
theorem bidirectionalPoissonAntisymmetricSector_eq_affinityExcess
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonAntisymmetricSector lawRates referenceRates history =
      drivenCycleOrientedCount history / 2 *
        (lawRates.toRealRates.affinity - referenceRates.toRealRates.affinity) := by
  rw [bidirectionalPoissonAntisymmetricSector_eq_logRateDifference
    hLaw hReference]
  have hLawClockwise : (lawRates.clockwise : ℝ) ≠ 0 := by
    exact_mod_cast hLaw.1.ne'
  have hLawCounterclockwise : (lawRates.counterclockwise : ℝ) ≠ 0 := by
    exact_mod_cast hLaw.2.ne'
  have hReferenceClockwise : (referenceRates.clockwise : ℝ) ≠ 0 := by
    exact_mod_cast hReference.1.ne'
  have hReferenceCounterclockwise : (referenceRates.counterclockwise : ℝ) ≠ 0 := by
    exact_mod_cast hReference.2.ne'
  unfold BidirectionalPoissonNNRates.toRealRates BidirectionalPoissonRates.affinity
  rw [Real.log_div hLawClockwise hReferenceClockwise,
    Real.log_div hLawCounterclockwise hReferenceCounterclockwise,
    Real.log_div hLawClockwise hLawCounterclockwise,
    Real.log_div hReferenceClockwise hReferenceCounterclockwise]
  ring

/-- Equal affinity makes the relative action pathwise purely time-symmetric. -/
theorem bidirectionalPoissonAntisymmetricSector_eq_zero_of_affinity_eq
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive)
    (hAffinity : lawRates.toRealRates.affinity = referenceRates.toRealRates.affinity)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonAntisymmetricSector lawRates referenceRates history = 0 := by
  rw [bidirectionalPoissonAntisymmetricSector_eq_affinityExcess hLaw hReference,
    hAffinity, sub_self, mul_zero]

/-- The symmetric sector is the exact total-traffic and escape-rate contribution. -/
theorem bidirectionalPoissonSymmetricSector_eq
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive)
    (history : DrivenCycleHistory) :
    bidirectionalPoissonSymmetricSector lawRates referenceRates history =
      drivenCycleTotalCount history / 2 *
          (Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
            Real.log ((lawRates.counterclockwise : ℝ) /
              referenceRates.counterclockwise)) -
        (lawRates.toRealRates.traffic - referenceRates.toRealRates.traffic) := by
  unfold bidirectionalPoissonSymmetricSector
  rw [bidirectionalPoissonCountLogLikelihoodRatio_affine hLaw hReference,
    bidirectionalPoissonCountLogLikelihoodRatio_affine hLaw hReference]
  simp only [drivenCycleHistoryReversal_clockwiseCount,
    drivenCycleHistoryReversal_counterclockwiseCount]
  unfold drivenCycleTotalCount
  ring

/-- The antisymmetric sector is integrable under the generated law. -/
theorem integrable_bidirectionalPoissonAntisymmetricSector
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    Integrable (bidirectionalPoissonAntisymmetricSector lawRates referenceRates)
      (bidirectionalPoissonHistoryMeasure lawRates) := by
  have hFunction : bidirectionalPoissonAntisymmetricSector lawRates referenceRates =
      fun history ↦ drivenCycleOrientedCount history / 2 *
        (lawRates.toRealRates.affinity - referenceRates.toRealRates.affinity) := by
    funext history
    exact bidirectionalPoissonAntisymmetricSector_eq_affinityExcess
      hLaw hReference history
  rw [hFunction]
  exact ((integrable_drivenCycleOrientedCount lawRates).div_const 2).mul_const _

/-- The symmetric sector is integrable under the generated law. -/
theorem integrable_bidirectionalPoissonSymmetricSector
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    Integrable (bidirectionalPoissonSymmetricSector lawRates referenceRates)
      (bidirectionalPoissonHistoryMeasure lawRates) := by
  have hFunction : bidirectionalPoissonSymmetricSector lawRates referenceRates =
      fun history ↦ drivenCycleTotalCount history / 2 *
          (Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
            Real.log ((lawRates.counterclockwise : ℝ) /
              referenceRates.counterclockwise)) -
        (lawRates.toRealRates.traffic - referenceRates.toRealRates.traffic) := by
    funext history
    exact bidirectionalPoissonSymmetricSector_eq hLaw hReference history
  rw [hFunction]
  exact (((integrable_drivenCycleTotalCount lawRates).div_const 2).mul_const _).sub
    (integrable_const _)

/-- Mean antisymmetric action is half mean current paired with excess affinity. -/
theorem integral_bidirectionalPoissonAntisymmetricSector
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    ∫ history, bidirectionalPoissonAntisymmetricSector lawRates referenceRates history
        ∂bidirectionalPoissonHistoryMeasure lawRates =
      lawRates.toRealRates.current / 2 *
        (lawRates.toRealRates.affinity - referenceRates.toRealRates.affinity) := by
  have hFunction : bidirectionalPoissonAntisymmetricSector lawRates referenceRates =
      fun history ↦ drivenCycleOrientedCount history / 2 *
        (lawRates.toRealRates.affinity - referenceRates.toRealRates.affinity) := by
    funext history
    exact bidirectionalPoissonAntisymmetricSector_eq_affinityExcess
      hLaw hReference history
  rw [hFunction, integral_mul_const, integral_div, integral_drivenCycleOrientedCount]

/-- Mean symmetric action is mean traffic paired with the symmetric log-rate change. -/
theorem integral_bidirectionalPoissonSymmetricSector
    {lawRates referenceRates : BidirectionalPoissonNNRates}
    (hLaw : lawRates.Positive) (hReference : referenceRates.Positive) :
    ∫ history, bidirectionalPoissonSymmetricSector lawRates referenceRates history
        ∂bidirectionalPoissonHistoryMeasure lawRates =
      lawRates.toRealRates.traffic / 2 *
          (Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
            Real.log ((lawRates.counterclockwise : ℝ) /
              referenceRates.counterclockwise)) -
        (lawRates.toRealRates.traffic - referenceRates.toRealRates.traffic) := by
  have hFunction : bidirectionalPoissonSymmetricSector lawRates referenceRates =
      fun history ↦ drivenCycleTotalCount history / 2 *
          (Real.log ((lawRates.clockwise : ℝ) / referenceRates.clockwise) +
            Real.log ((lawRates.counterclockwise : ℝ) /
              referenceRates.counterclockwise)) -
        (lawRates.toRealRates.traffic - referenceRates.toRealRates.traffic) := by
    funext history
    exact bidirectionalPoissonSymmetricSector_eq hLaw hReference history
  rw [hFunction]
  rw [integral_sub
    (((integrable_drivenCycleTotalCount lawRates).div_const 2).mul_const _)
    (integrable_const _),
    integral_mul_const, integral_div, integral_drivenCycleTotalCount, integral_const]
  simp

/-- Count log density against the direction-swapped law selected by physical reversal. -/
noncomputable def physicalPoissonCountLogDensity
    (rates : BidirectionalPoissonNNRates) (history : DrivenCycleHistory) : ℝ :=
  bidirectionalPoissonCountLogLikelihoodRatio rates rates.swap history

/-- The physical count log density is path current paired with directional affinity. -/
theorem physicalPoissonCountLogDensity_eq_current_mul_affinity
    {rates : BidirectionalPoissonNNRates} (hRates : rates.Positive)
    (history : DrivenCycleHistory) :
    physicalPoissonCountLogDensity rates history =
      drivenCycleOrientedCount history * rates.toRealRates.affinity := by
  unfold physicalPoissonCountLogDensity
  rw [bidirectionalPoissonCountLogLikelihoodRatio_affine hRates
    (BidirectionalPoissonNNRates.swap_positive hRates)]
  unfold BidirectionalPoissonNNRates.swap BidirectionalPoissonNNRates.toRealRates
  unfold BidirectionalPoissonRates.traffic BidirectionalPoissonRates.affinity
  rw [Real.log_div (by exact_mod_cast hRates.1.ne') (by exact_mod_cast hRates.2.ne'),
    Real.log_div (by exact_mod_cast hRates.2.ne') (by exact_mod_cast hRates.1.ne')]
  unfold drivenCycleOrientedCount
  ring

/-- Physical count density changes sign under registered reversal. -/
theorem physicalPoissonCountLogDensity_reversal
    {rates : BidirectionalPoissonNNRates} (hRates : rates.Positive)
    (history : DrivenCycleHistory) :
    physicalPoissonCountLogDensity rates (drivenCycleHistoryReversal history) =
      -physicalPoissonCountLogDensity rates history := by
  rw [physicalPoissonCountLogDensity_eq_current_mul_affinity hRates,
    physicalPoissonCountLogDensity_eq_current_mul_affinity hRates,
    drivenCycleOrientedCount_reversal]
  ring

/-- Mean physical reversal density is the bidirectional entropy action. -/
theorem integral_physicalPoissonCountLogDensity
    {rates : BidirectionalPoissonNNRates} (hRates : rates.Positive) :
    ∫ history, physicalPoissonCountLogDensity rates history
        ∂bidirectionalPoissonHistoryMeasure rates =
      bidirectionalPoissonEntropyAction rates.toRealRates := by
  simp_rw [physicalPoissonCountLogDensity_eq_current_mul_affinity hRates]
  rw [integral_mul_const, integral_drivenCycleOrientedCount]
  exact (bidirectionalPoissonEntropyAction_eq_current_mul_affinity
    (BidirectionalPoissonNNRates.toRealRates_positive hRates)).symm

