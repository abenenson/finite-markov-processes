import FiniteMarkovProcesses.RelativeEntropy.FiniteStateProbabilityDensity
import FiniteMarkovProcesses.RelativeEntropy.RengerHybridBVPositiveTargetRegularization
import FiniteMarkovProcesses.RelativeEntropy.RengerHybridBVTargetForwardEquation
import FiniteMarkovProcesses.Probability.FiniteStateTimeDependentMarkovForwardEquation

/-!
# Physical source mean generated by a positive Renger target regularization

The recovered target initial trace is converted to an exact finite PMF and evolved under the
canonical bounded positive target regularization.  The physical endpoint PMF is defined by
the normalized time-dependent jump law.  Subtracting its forward equation from the target's
hybrid-BV forward equation exposes the exact flow-divergence residual.

No equality or convergence between the physical source mean and the target is asserted here.
-/

namespace FiniteMarkovProcesses.InformationTheory

open MeasureTheory Set
open scoped BigOperators ENNReal NNReal

open FiniteMarkovProcesses
open FiniteMarkovProcesses.Probability

universe u

noncomputable section

variable {State : Type u} [Fintype State] [DecidableEq State]
  [MeasurableSpace State] [MeasurableSingletonClass State]
  {duration : ℝ}

/-- Exact finite probability density recovered from an admissible target's initial trace. -/
noncomputable def rengerDirectionalFlowHybridBVTargetInitialProbabilityDensity
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration) :
    FiniteStateProbabilityDensity State where
  weight := rengerDirectionalFlowHybridBVInitialDensity path.1
  sum_weight := by
    apply NNReal.eq
    simp only [NNReal.coe_sum, NNReal.coe_one,
      rengerDirectionalFlowHybridBVInitialDensity]
    simp_rw [Real.coe_toNNReal _ (path.2.initialDensityNonnegative _)]
    exact path.2.initialDensityNormalized

/-- Exact initial PMF used by every canonical positive regularized physical source. -/
noncomputable def rengerDirectionalFlowHybridBVTargetInitialPMF
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration) :
    PMF State :=
  (rengerDirectionalFlowHybridBVTargetInitialProbabilityDensity path).probabilityMassFunction

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- The target-initial PMF retains every recovered initial coordinate exactly. -/
@[simp]
theorem rengerDirectionalFlowHybridBVTargetInitialPMF_apply
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (state : State) :
    rengerDirectionalFlowHybridBVTargetInitialPMF path state =
      (rengerDirectionalFlowHybridBVInitialDensity path.1 state : ENNReal) :=
  rfl

/-- Physical endpoint PMF generated from the target initial trace by one canonical positive
regularized rate. -/
noncomputable def rengerDirectionalFlowHybridBVCanonicalPositiveTargetEndpointPMF
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (index : ℕ) (time : ℝ≥0) : PMF State :=
  finiteStateTimeDependentMarkovEndpointPMF
    (rengerDirectionalFlowHybridBVTargetInitialPMF path)
    (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
      generator path.1 index)
    time

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- At time zero, the physical regularized source mean is exactly the recovered target initial
PMF. -/
@[simp]
theorem rengerDirectionalFlowHybridBVCanonicalPositiveTargetEndpointPMF_zero
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (index : ℕ) :
    rengerDirectionalFlowHybridBVCanonicalPositiveTargetEndpointPMF
      generator path index 0 =
        rengerDirectionalFlowHybridBVTargetInitialPMF path := by
  ext state
  rw [rengerDirectionalFlowHybridBVCanonicalPositiveTargetEndpointPMF,
    finiteStateTimeDependentMarkovEndpointPMF_apply]
  unfold finiteStateTimeDependentMarkovEndpointProbability
  rw [finiteStateTimeDependentMarkovUniformizedEndpointSeries_eq_initial_add_lintegral]
  simp

/-- The physical-source density error is exactly generated-flow divergence minus target-flow
divergence.  This is the forcing identity for the subsequent stability estimate. -/
theorem rengerDirectionalFlowHybridBVCanonicalPositiveTargetEndpointDensity_sub_targetDensity_eq
    (generator : FiniteStateMarkovGenerator State)
    (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (index : ℕ) (time : ℝ≥0) (hTimeDuration : (time : ℝ) < duration)
    (state : State) :
    (rengerDirectionalFlowHybridBVCanonicalPositiveTargetEndpointPMF
        generator path index time state).toReal -
        rengerDirectionalFlowHybridBVDensityValue path.1 time state =
      ((∑ source ∈ Finset.univ.erase state,
          ∫ markedTime : ℝ in Ioo 0 (time : ℝ),
            (finiteStateTimeDependentMarkovEndpointProbability
              (rengerDirectionalFlowHybridBVTargetInitialPMF path)
              (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
                generator path.1 index)
              markedTime source).toReal *
            ((rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
                generator path.1 index).rate markedTime source state : ℝ)) -
        (∑ target ∈ Finset.univ.erase state,
          ∫ markedTime : ℝ in Ioo 0 (time : ℝ),
            (finiteStateTimeDependentMarkovEndpointProbability
              (rengerDirectionalFlowHybridBVTargetInitialPMF path)
              (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
                generator path.1 index)
              markedTime state).toReal *
            ((rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
                generator path.1 index).rate markedTime state target : ℝ))) -
        ∫ markedTime : ℝ in Ioo 0 (time : ℝ),
          ((∑ source : {source : State // source ≠ state},
              rengerDirectionalFlowHybridBVFlowDerivative path.1 markedTime
                ⟨(source.1, state), source.property⟩) -
            ∑ target : {target : State // target ≠ state},
              rengerDirectionalFlowHybridBVFlowDerivative path.1 markedTime
                ⟨(state, target.1), target.property.symm⟩) := by
  have hSourceForward :=
    finiteStateTimeDependentMarkovEndpointProbability_eq_initial_add_incoming_sub_outgoing
      (rengerDirectionalFlowHybridBVTargetInitialPMF path)
      (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
        generator path.1 index)
      time state
  have hTargetForward :=
    rengerDirectionalFlowHybridBVDensityValue_eq_initial_add_integral_flowDivergence
      hDuration path ⟨time.coe_nonneg, hTimeDuration⟩ state
  have hInitial :
      (rengerDirectionalFlowHybridBVTargetInitialPMF path state).toReal =
        path.1.initialTrace (Sum.inl state) := by
    rw [rengerDirectionalFlowHybridBVTargetInitialPMF_apply]
    rw [ENNReal.coe_toReal]
    exact Real.coe_toNNReal _ (path.2.initialDensityNonnegative state)
  change
    (finiteStateTimeDependentMarkovEndpointProbability
      (rengerDirectionalFlowHybridBVTargetInitialPMF path)
      (rengerDirectionalFlowHybridBVCanonicalPositiveTargetRegularization
        generator path.1 index)
      time state).toReal -
      rengerDirectionalFlowHybridBVDensityValue path.1 time state = _
  rw [hSourceForward, hTargetForward, hInitial]
  ring

end

end FiniteMarkovProcesses.InformationTheory
