import Mathlib.Analysis.SpecialFunctions.Log.ENNRealLog
import Mathlib.Order.LiminfLimsup
import Mathlib.Probability.Independence.Basic
import FiniteMarkovProcesses.RelativeEntropy.FiniteOrientedPoissonGraphDynamics

/-!
# Density--flux large-deviation representation boundary

This file gives a typed contract for crossing from exact normalized microscopic laws to a
macroscopic density--flux large-deviation statement.  The contract owns the observation map,
speed, topology, continuity constraint, local path integrand, initial and boundary costs, and the
actual open/closed large-deviation bounds.  A quasipotential is then a separate contraction of the
path rate onto terminal density.

The file also records the stronger finite-replication evidence required before a common intensity
scale may be called an independent-particle realization.  Exact KL extensivity under a faster
common Poisson clock does not construct the replica law, independence, coordinate marginals, or
complete-history aggregation map required by `CompleteHistoryReplicationRealization`.

These structures package hypotheses and bounds. They do not themselves prove a large-deviation
principle for a finite graph generator; concrete realizations must supply both bounds.

## Main definitions

- `scaledEventLogProbability`: exact extended log probability divided by a named speed.
- `HasLargeDeviationUpperBound` and `HasLargeDeviationLowerBound`: literal closed/open bounds.
- `TopologyGeneratesMeasurableSpace`: the measurable space is the Borel sigma algebra of the
  declared topology.
- `IsGoodRateFunction`: every finite extended-rate sublevel is compact.
- `DensityFluxPathRateData.pathRate`: continuity-gated initial/local/boundary path cost.
- `DensityFluxPathRateData.quasipotential`: terminal-density contraction of that path cost.
- `DensityFluxLargeDeviationRepresentation`: normalized-law, observation, speed, rate, provenance,
  and two-bound representation contract.
- `CompleteHistoryReplicationRealization`: independent-replica and aggregation contract that clock
  scaling alone does not discharge.
-/

namespace FiniteMarkovProcesses.InformationTheory

open MeasureTheory
open ProbabilityTheory
open scoped ENNReal

universe u₁ u₂ u₃ u₄ u₅ u₆

/-- Extended log probability of one observed event divided by the declared macroscopic speed.
Probability zero remains visible as `⊥`; no `toReal` truncation occurs. -/
noncomputable def scaledEventLogProbability
    {MicroscopicPath : Type u₁} {MacroscopicPath : Type u₂}
    [MeasurableSpace MicroscopicPath]
    (microscopicLaw : ℕ → Measure MicroscopicPath)
    (observation : ℕ → MicroscopicPath → MacroscopicPath)
    (speed : ℕ → ℝ) (sampleSize : ℕ) (event : Set MacroscopicPath) : EReal :=
  (microscopicLaw sampleSize (observation sampleSize ⁻¹' event)).log /
    (speed sampleSize : EReal)

/-- A literal large-deviation upper bound on every closed macroscopic event. -/
def HasLargeDeviationUpperBound
    {MacroscopicPath : Type u₂} [TopologicalSpace MacroscopicPath]
    (scaledLogProbability : ℕ → Set MacroscopicPath → EReal)
    (rate : MacroscopicPath → ENNReal) : Prop :=
  ∀ closedSet : Set MacroscopicPath, IsClosed closedSet →
    Filter.limsup (fun sampleSize ↦ scaledLogProbability sampleSize closedSet)
        Filter.atTop ≤
      -(⨅ path ∈ closedSet, (rate path : EReal))

/-- A literal large-deviation lower bound on every open macroscopic event. -/
def HasLargeDeviationLowerBound
    {MacroscopicPath : Type u₂} [TopologicalSpace MacroscopicPath]
    (scaledLogProbability : ℕ → Set MacroscopicPath → EReal)
    (rate : MacroscopicPath → ENNReal) : Prop :=
  ∀ openSet : Set MacroscopicPath, IsOpen openSet →
    -(⨅ path ∈ openSet, (rate path : EReal)) ≤
      Filter.liminf (fun sampleSize ↦ scaledLogProbability sampleSize openSet)
        Filter.atTop

/-- The measurable space on a macroscopic carrier is exactly the Borel sigma algebra generated by
its declared topology.  This prevents a convenient unrelated measurable structure from being used
for finite observations while open and closed sets come from another topology. -/
def TopologyGeneratesMeasurableSpace
    (MacroscopicPath : Type u₂) [MeasurableSpace MacroscopicPath]
    [TopologicalSpace MacroscopicPath] : Prop :=
  (inferInstance : MeasurableSpace MacroscopicPath) = borel MacroscopicPath

/-- A nonnegative extended rate is good when every finite sublevel set is compact. -/
def IsGoodRateFunction
    {MacroscopicPath : Type u₂} [TopologicalSpace MacroscopicPath]
    (rate : MacroscopicPath → ENNReal) : Prop :=
  ∀ bound : NNReal, IsCompact {path | rate path ≤ bound}

/-- On a Hausdorff carrier, compact finite sublevels make an extended rate lower
semicontinuous. -/
theorem IsGoodRateFunction.lowerSemicontinuous
    {MacroscopicPath : Type u₂} [TopologicalSpace MacroscopicPath] [T2Space MacroscopicPath]
    {rate : MacroscopicPath → ENNReal} (hRate : IsGoodRateFunction rate) :
    LowerSemicontinuous rate := by
  rw [lowerSemicontinuous_iff_isClosed_preimage]
  intro level
  by_cases hLevel : level = ∞
  · subst level
    convert (isClosed_univ : IsClosed (Set.univ : Set MacroscopicPath)) using 1
    ext path
    simp only [Set.mem_preimage, Set.mem_Iic, le_top, Set.mem_univ]
  · have hClosed := (hRate level.toNNReal).isClosed
    convert hClosed using 1
    ext path
    simp only [Set.mem_preimage, Set.mem_Iic, Set.mem_ofPred_eq]
    rw [ENNReal.coe_toNNReal hLevel]

/-- Data needed to state a density--flux path rate without confusing its local integrand,
initial law, boundary cost, or continuity domain. -/
structure DensityFluxPathRateData
    (MacroscopicPath : Type u₂) (Time : Type u₃)
    (Density : Type u₄) (Flux : Type u₅)
    [MeasurableSpace Time] where
  /-- Supplied density observation along each macroscopic path and time. -/
  densityAt : MacroscopicPath → Time → Density
  /-- Supplied flux observation along each macroscopic path and time. -/
  fluxAt : MacroscopicPath → Time → Flux
  /-- Supplied terminal-density observation used in the path-rate contraction. -/
  terminalDensity : MacroscopicPath → Density
  /-- Supplied time measure for the local-action integral. -/
  timeMeasure : Measure Time
  /-- Supplied nonnegative extended local action on density and flux data. -/
  localAction : Density → Flux → ENNReal
  /-- Supplied AE-measurability of the local-action integrand for every path. -/
  localAction_aemeasurable :
    ∀ path, AEMeasurable
      (fun time ↦ localAction (densityAt path time) (fluxAt path time))
      timeMeasure
  /-- Supplied initial path cost, separate from the local integral and boundary cost. -/
  initialCost : MacroscopicPath → ENNReal
  /-- Supplied boundary path cost, separate from the initial cost and local integral. -/
  boundaryCost : MacroscopicPath → ENNReal
  /-- Supplied continuity domain; the path rate is infinite outside this predicate. -/
  continuityAdmissible : MacroscopicPath → Prop

namespace DensityFluxPathRateData

/-- The complete path rate: initial cost plus time-integrated local density--flux action plus
boundary cost on the continuity domain, and infinite cost off that domain. -/
noncomputable def pathRate
    {MacroscopicPath : Type u₂} {Time : Type u₃}
    {Density : Type u₄} {Flux : Type u₅}
    [MeasurableSpace Time]
    (data : DensityFluxPathRateData MacroscopicPath Time Density Flux)
    (path : MacroscopicPath) : ENNReal := by
  classical
  exact if data.continuityAdmissible path then
    data.initialCost path +
      ∫⁻ time,
        data.localAction (data.densityAt path time) (data.fluxAt path time)
          ∂data.timeMeasure +
      data.boundaryCost path
  else ∞

/-- On the declared continuity domain the path rate exposes all three owned sectors. -/
theorem pathRate_eq_of_continuityAdmissible
    {MacroscopicPath : Type u₂} {Time : Type u₃}
    {Density : Type u₄} {Flux : Type u₅}
    [MeasurableSpace Time]
    (data : DensityFluxPathRateData MacroscopicPath Time Density Flux)
    {path : MacroscopicPath} (hPath : data.continuityAdmissible path) :
    data.pathRate path =
      data.initialCost path +
        ∫⁻ time,
          data.localAction (data.densityAt path time) (data.fluxAt path time)
            ∂data.timeMeasure +
        data.boundaryCost path := by
  simp [pathRate, hPath]

/-- A path outside the continuity domain receives infinite rate. -/
theorem pathRate_eq_top_of_not_continuityAdmissible
    {MacroscopicPath : Type u₂} {Time : Type u₃}
    {Density : Type u₄} {Flux : Type u₅}
    [MeasurableSpace Time]
    (data : DensityFluxPathRateData MacroscopicPath Time Density Flux)
    {path : MacroscopicPath} (hPath : ¬data.continuityAdmissible path) :
    data.pathRate path = ∞ := by
  simp [pathRate, hPath]

/-- Terminal-density quasipotential obtained by contracting the complete path rate.  This
definition does not identify it with the separately supplied initial or boundary cost. -/
noncomputable def quasipotential
    {MacroscopicPath : Type u₂} {Time : Type u₃}
    {Density : Type u₄} {Flux : Type u₅}
    [MeasurableSpace Time]
    (data : DensityFluxPathRateData MacroscopicPath Time Density Flux)
    (terminalDensity : Density) : ENNReal :=
  ⨅ path, ⨅ (_ : data.terminalDensity path = terminalDensity), data.pathRate path

/-- Every path ending at the requested density bounds its quasipotential from above. -/
theorem quasipotential_le_pathRate
    {MacroscopicPath : Type u₂} {Time : Type u₃}
    {Density : Type u₄} {Flux : Type u₅}
    [MeasurableSpace Time]
    (data : DensityFluxPathRateData MacroscopicPath Time Density Flux)
    {path : MacroscopicPath} {terminalDensity : Density}
    (hTerminal : data.terminalDensity path = terminalDensity) :
    data.quasipotential terminalDensity ≤ data.pathRate path := by
  exact le_trans (iInf_le _ path) (iInf_le_of_le hTerminal le_rfl)

end DensityFluxPathRateData

/-- Provenance-bearing representation of a density--flux path rate by an actual sequence of
normalized microscopic laws.  Both LDP bounds are fields, not consequences of the type alone. -/
structure DensityFluxLargeDeviationRepresentation
    (MicroscopicPath : Type u₁) (MacroscopicPath : Type u₂)
    (Time : Type u₃) (Density : Type u₄) (Flux : Type u₅)
    (Provenance : Type u₆)
    [MeasurableSpace MicroscopicPath]
    [MeasurableSpace MacroscopicPath]
    [TopologicalSpace MacroscopicPath]
    [MeasurableSpace Time] where
  /-- Supplied microscopic law at each sample size. -/
  microscopicLaw : ℕ → Measure MicroscopicPath
  /-- Supplied normalization of every microscopic law. -/
  microscopicLaw_probability :
    ∀ sampleSize, IsProbabilityMeasure (microscopicLaw sampleSize)
  /-- Supplied observation from microscopic to macroscopic paths at each sample size. -/
  observation : ℕ → MicroscopicPath → MacroscopicPath
  /-- Supplied measurability of every microscopic-to-macroscopic observation. -/
  observation_measurable :
    ∀ sampleSize, Measurable (observation sampleSize)
  /-- Supplied real scaling speed for the extended log probabilities. -/
  speed : ℕ → ℝ
  /-- Supplied strict positivity of the scaling speed at every sample size. -/
  speed_pos : ∀ sampleSize, 0 < speed sampleSize
  /-- Supplied divergence of the scaling speed along increasing sample sizes. -/
  speed_tendsto_atTop : Filter.Tendsto speed Filter.atTop Filter.atTop
  /-- Supplied complete density--flux rate data, including costs and continuity domain. -/
  rateData : DensityFluxPathRateData MacroscopicPath Time Density Flux
  /-- Supplied equality of the macroscopic measurable space with its declared Borel space. -/
  topology_generates_measurableSpace : TopologyGeneratesMeasurableSpace MacroscopicPath
  /-- Supplied compactness of every finite sublevel of the complete path rate. -/
  rate_good : IsGoodRateFunction rateData.pathRate
  /-- Supplied provenance witness; no historical or physical bridge is inferred from it. -/
  provenance : Provenance
  /-- Supplied large-deviation upper bound on every closed macroscopic event. -/
  upperBound :
    HasLargeDeviationUpperBound
      (scaledEventLogProbability microscopicLaw observation speed)
      rateData.pathRate
  /-- Supplied large-deviation lower bound on every open macroscopic event. -/
  lowerBound :
    HasLargeDeviationLowerBound
      (scaledEventLogProbability microscopicLaw observation speed)
      rateData.pathRate

namespace DensityFluxLargeDeviationRepresentation

variable {MicroscopicPath : Type u₁} {MacroscopicPath : Type u₂}
  {Time : Type u₃} {Density : Type u₄} {Flux : Type u₅}
  {Provenance : Type u₆}
  [MeasurableSpace MicroscopicPath]
  [MeasurableSpace MacroscopicPath]
  [TopologicalSpace MacroscopicPath]
  [MeasurableSpace Time]

/-- Exact normalized macroscopic law at a finite sample size. -/
noncomputable def observationLaw
    (representation : DensityFluxLargeDeviationRepresentation
      MicroscopicPath MacroscopicPath Time Density Flux Provenance)
    (sampleSize : ℕ) : Measure MacroscopicPath :=
  Measure.map (representation.observation sampleSize)
    (representation.microscopicLaw sampleSize)

/-- Every finite observed law remains normalized. -/
theorem observationLaw_isProbabilityMeasure
    (representation : DensityFluxLargeDeviationRepresentation
      MicroscopicPath MacroscopicPath Time Density Flux Provenance)
    (sampleSize : ℕ) :
    IsProbabilityMeasure (representation.observationLaw sampleSize) := by
  let : IsProbabilityMeasure (representation.microscopicLaw sampleSize) :=
    representation.microscopicLaw_probability sampleSize
  unfold observationLaw
  exact (Measure.isProbabilityMeasure_map_iff
    (representation.observation_measurable sampleSize).aemeasurable).2 inferInstance

/-- On measurable macroscopic events, the scaled probability in the LDP bounds is literally the
extended log of the exact pushed-forward law divided by the named speed. -/
theorem scaledEventLogProbability_eq_observationLaw
    (representation : DensityFluxLargeDeviationRepresentation
      MicroscopicPath MacroscopicPath Time Density Flux Provenance)
    (sampleSize : ℕ) {event : Set MacroscopicPath} (hEvent : MeasurableSet event) :
    scaledEventLogProbability representation.microscopicLaw
        representation.observation representation.speed sampleSize event =
      (representation.observationLaw sampleSize event).log /
        (representation.speed sampleSize : EReal) := by
  unfold scaledEventLogProbability observationLaw
  rw [Measure.map_apply (representation.observation_measurable sampleSize) hEvent]

end DensityFluxLargeDeviationRepresentation

/-- Evidence that an aggregate complete-history law genuinely comes from finitely many
independent replicas of one complete-history law.  This is deliberately stronger than equality
of rate parameters or KL extensivity: it owns a normalized joint replica law, independence, every
coordinate marginal, a measurable aggregation map, and the exact aggregate pushforward law. -/
structure CompleteHistoryReplicationRealization
    (ReplicaHistory : Type u₁) (AggregateHistory : Type u₂)
    [MeasurableSpace ReplicaHistory] [MeasurableSpace AggregateHistory]
    (replicaCount : ℕ)
    (singleReplicaLaw : Measure ReplicaHistory)
    (aggregateHistoryLaw : Measure AggregateHistory) where
  /-- Supplied joint law of the complete finite replica-history family. -/
  replicaLaw : Measure (Fin replicaCount → ReplicaHistory)
  /-- Supplied normalization of the joint replica-history law. -/
  replicaLaw_probability : IsProbabilityMeasure replicaLaw
  /-- Supplied independence of the coordinate histories under the joint replica law. -/
  replicasIndependent :
    ProbabilityTheory.iIndepFun
      (fun replica : Fin replicaCount ↦
        fun history : Fin replicaCount → ReplicaHistory ↦ history replica)
      replicaLaw
  /-- Supplied equality of every coordinate marginal with the complete single-replica law. -/
  coordinateMarginal :
    ∀ replica,
      Measure.map (fun history ↦ history replica) replicaLaw = singleReplicaLaw
  /-- Supplied aggregation map from the complete replica family to an aggregate history. -/
  aggregateHistory : (Fin replicaCount → ReplicaHistory) → AggregateHistory
  /-- Supplied measurability of the complete-history aggregation map. -/
  aggregateHistory_measurable : Measurable aggregateHistory
  /-- Supplied whole-measure equality of the aggregate pushforward with the named law. -/
  aggregateHistoryLaw_eq :
    Measure.map aggregateHistory replicaLaw = aggregateHistoryLaw

end FiniteMarkovProcesses.InformationTheory
