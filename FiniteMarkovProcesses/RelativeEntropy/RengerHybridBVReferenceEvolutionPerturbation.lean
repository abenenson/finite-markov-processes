import
  FiniteMarkovProcesses.RelativeEntropy.RengerHybridBVPositiveTargetSourceMean
import FiniteMarkovProcesses.Probability.FiniteStateTimeDependentMarkovForwardDerivative

/-!
# Reference-evolution interior perturbation of a Renger target

The unchanged reference generator evolves the target's own initial density.  Mixing this exact
reference evolution into a finite-action target preserves normalization and supplies a strictly
positive density coordinate at every finite nonnegative time whenever the initial density is
coordinatewise positive.  The lower bound comes from the literal no-event sector and requires no
irreducibility or stationary law.

This module constructs the pointwise density and directional-flow perturbation data.  It does not
yet package those data as a hybrid-BV path, prove an action limit, or assert a large-deviation
lower bound.
-/

namespace FiniteMarkovProcesses.InformationTheory

open MeasureTheory
open scoped BigOperators ENNReal NNReal

open FiniteMarkovProcesses.Probability

universe u

noncomputable section

variable {State : Type u} [Fintype State] [DecidableEq State]
  [MeasurableSpace State] [MeasurableSingletonClass State]
  {duration : ℝ}

/-- Density generated by the unchanged homogeneous reference dynamics from the target's recovered
initial PMF. -/
noncomputable def rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (time : ℝ) (state : State) : ℝ :=
  (finiteStateTimeDependentMarkovEndpointProbability
    (rengerDirectionalFlowHybridBVTargetInitialPMF path)
    generator.toTimeDependentMarkovRate time state).toReal

/-- Expected ordered flow of the unchanged homogeneous reference evolution. -/
noncomputable def rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (time : ℝ) (source target : State) : ℝ :=
  rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
      generator path time source *
    (generator.rate source target : ℝ)

/-- Pointwise density of the reference-evolution interior perturbation. -/
noncomputable def rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (mixingWeight : ℝ) (time : ℝ) (state : State) : ℝ :=
  (1 - mixingWeight) *
      rengerDirectionalFlowHybridBVDensityValue path.1 time state +
    mixingWeight *
      rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
        generator path time state

/-- Pointwise ordered flow of the reference-evolution interior perturbation. -/
noncomputable def rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowValue
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (mixingWeight : ℝ) (time : ℝ) (source target : State) : ℝ :=
  (1 - mixingWeight) *
      rengerDirectionalFlowHybridBVRawFlowDerivativeValue
        path.1 time source target +
    mixingWeight *
      rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue
        generator path time source target

/-- Incoming-minus-outgoing divergence of the reference-evolution ordered flow. -/
noncomputable def rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (time : ℝ) (state : State) : ℝ :=
  finiteStateFlowDivergence
    (rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue
      generator path time) state

/-- Incoming-minus-outgoing divergence of the perturbed ordered flow. -/
noncomputable def rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowDivergence
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (mixingWeight : ℝ) (time : ℝ) (state : State) : ℝ :=
  finiteStateFlowDivergence
    (rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowValue
      generator path mixingWeight time) state

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- The reference evolution retains a strictly positive coordinate at every nonnegative finite
time when that coordinate has positive recovered initial mass. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue_pos
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    {time : ℝ} (hTime : 0 ≤ time) (state : State)
    (hInitial : 0 < rengerDirectionalFlowHybridBVInitialDensity path.1 state) :
    0 < rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
      generator path time state := by
  have hInitialReal :
      0 < (rengerDirectionalFlowHybridBVTargetInitialPMF path state).toReal := by
    rw [rengerDirectionalFlowHybridBVTargetInitialPMF_apply, ENNReal.coe_toReal]
    exact_mod_cast hInitial
  have hLower :=
    exp_neg_uniformizationRate_mul_duration_mul_initial_toReal_le_endpointProbability_toReal
      (rengerDirectionalFlowHybridBVTargetInitialPMF path)
      generator.toTimeDependentMarkovRate time hTime state
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
  exact lt_of_lt_of_le (mul_pos (Real.exp_pos _) hInitialReal) hLower

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- On the full finite physical interval, the reference evolution has the uniform no-event lower
bound obtained by evaluating survival at the terminal horizon. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue_uniformLowerBound
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    {time : ℝ} (hTimeNonnegative : 0 ≤ time) (hTimeDuration : time ≤ duration)
    (state : State) :
    Real.exp
          (-((generator.toTimeDependentMarkovRate.uniformizationRate : ℝ) * duration)) *
        (rengerDirectionalFlowHybridBVTargetInitialPMF path state).toReal ≤
      rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
        generator path time state := by
  have hTimeLower :=
    exp_neg_uniformizationRate_mul_duration_mul_initial_toReal_le_endpointProbability_toReal
      (rengerDirectionalFlowHybridBVTargetInitialPMF path)
      generator.toTimeDependentMarkovRate time hTimeNonnegative state
  apply le_trans ?_ hTimeLower
  apply mul_le_mul_of_nonneg_right _ ENNReal.toReal_nonneg
  apply Real.exp_le_exp.mpr
  have hClockNonnegative :
      0 ≤ (generator.toTimeDependentMarkovRate.uniformizationRate : ℝ) := by
    positivity
  nlinarith

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- Mixing any positive amount of reference evolution into a nonnegative target gives a strictly
positive density coordinate at every nonnegative finite time. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue_pos
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    {mixingWeight time : ℝ} (hMixingWeight : 0 < mixingWeight)
    (hMixingWeightLeOne : mixingWeight ≤ 1) (hTime : 0 ≤ time)
    (state : State)
    (hInitial : 0 < rengerDirectionalFlowHybridBVInitialDensity path.1 state)
    (hTargetNonnegative :
      0 ≤ rengerDirectionalFlowHybridBVDensityValue path.1 time state) :
    0 < rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
      generator path mixingWeight time state := by
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
  exact add_pos_of_nonneg_of_pos
    (mul_nonneg (sub_nonneg.mpr hMixingWeightLeOne) hTargetNonnegative)
    (mul_pos hMixingWeight
      (rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue_pos
        generator path hTime state hInitial))

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- The interior perturbation inherits an explicit uniform density floor on the full physical
interval. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue_uniformLowerBound
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    {mixingWeight time : ℝ} (hMixingWeightNonnegative : 0 ≤ mixingWeight)
    (hMixingWeightLeOne : mixingWeight ≤ 1) (hTimeNonnegative : 0 ≤ time)
    (hTimeDuration : time ≤ duration) (state : State)
    (hTargetNonnegative :
      0 ≤ rengerDirectionalFlowHybridBVDensityValue path.1 time state) :
    mixingWeight *
          (Real.exp
              (-((generator.toTimeDependentMarkovRate.uniformizationRate : ℝ) * duration)) *
            (rengerDirectionalFlowHybridBVTargetInitialPMF path state).toReal) ≤
      rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
        generator path mixingWeight time state := by
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
  have hTargetSector :
      0 ≤ (1 - mixingWeight) *
        rengerDirectionalFlowHybridBVDensityValue path.1 time state :=
    mul_nonneg (sub_nonneg.mpr hMixingWeightLeOne) hTargetNonnegative
  have hReferenceSector := mul_le_mul_of_nonneg_left
    (rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue_uniformLowerBound
      generator path hTimeNonnegative hTimeDuration state)
    hMixingWeightNonnegative
  linarith

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- Reference-evolution ordered flow is pointwise nonnegative. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue_nonnegative
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (time : ℝ) (source target : State) :
    0 ≤ rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue
      generator path time source target := by
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue
    rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
  positivity

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- Convex mixing preserves pointwise ordered-flow nonnegativity. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowValue_nonnegative
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    {mixingWeight : ℝ} (hMixingWeightNonnegative : 0 ≤ mixingWeight)
    (hMixingWeightLeOne : mixingWeight ≤ 1) (time : ℝ) (source target : State)
    (hTargetNonnegative :
      0 ≤ rengerDirectionalFlowHybridBVRawFlowDerivativeValue
        path.1 time source target) :
    0 ≤ rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowValue
      generator path mixingWeight time source target := by
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowValue
  exact add_nonneg
    (mul_nonneg (sub_nonneg.mpr hMixingWeightLeOne) hTargetNonnegative)
    (mul_nonneg hMixingWeightNonnegative
      (rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue_nonnegative
        generator path time source target))

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- The reference-evolution flow divergence is exactly the finite-state forward drift. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence_eq_drift
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (time : ℝ) (state : State) :
    rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence
        generator path time state =
      finiteStateTimeDependentMarkovEndpointProbabilityDrift
        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
        generator.toTimeDependentMarkovRate time state := by
  symm
  simpa only [rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence,
    rengerDirectionalFlowHybridBVReferenceEvolutionFlowValue,
    rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue] using!
    finiteStateTimeDependentMarkovEndpointProbabilityDrift_eq_flowDivergence
      (rengerDirectionalFlowHybridBVTargetInitialPMF path)
      generator.toTimeDependentMarkovRate time state

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- Divergence commutes exactly with the reference-evolution convex mixture. -/
theorem rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowDivergence_eq
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (mixingWeight time : ℝ) (state : State) :
    rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowDivergence
        generator path mixingWeight time state =
      (1 - mixingWeight) *
          rengerDirectionalFlowHybridBVTargetFlowDivergence path.1 time state +
        mixingWeight *
          rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence
            generator path time state := by
  rw [rengerDirectionalFlowHybridBVTargetFlowDivergence_eq_rawFlowDivergence]
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowDivergence
    rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowValue
    rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence
    finiteStateFlowDivergence
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
  ring

/-- Almost everywhere on the physical interval, perturbed flow divergence is the classical
derivative of the perturbed density coordinate. -/
theorem ae_hasDerivAt_rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
    (generator : FiniteStateMarkovGenerator State)
    (hDuration : 0 < duration)
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (mixingWeight : ℝ) (state : State) :
    ∀ᵐ time ∂finiteOpenIntervalVolume duration,
      HasDerivAt
        (fun horizon ↦
          rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
            generator path mixingWeight horizon state)
        (rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowDivergence
          generator path mixingWeight time state)
        time := by
  have hReferenceDerivative :
      ∀ᵐ time ∂finiteOpenIntervalVolume duration,
        HasDerivAt
          (fun horizon ↦
            rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
              generator path horizon state)
          (rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence
            generator path time state)
          time := by
    have hDerivative :=
      ae_hasDerivAt_finiteStateTimeDependentMarkovEndpointProbability
        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
        generator.toTimeDependentMarkovRate ⟨duration, hDuration.le⟩ state
    simpa only [finiteOpenIntervalVolume,
      rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue,
      rengerDirectionalFlowHybridBVReferenceEvolutionFlowDivergence_eq_drift] using!
      hDerivative
  filter_upwards [ae_hasDerivAt_rengerDirectionalFlowHybridBVDensityValue
    hDuration path state, hReferenceDerivative] with time hTarget hReference
  have hDerivative :=
    (hTarget.const_mul (1 - mixingWeight)).add
      (hReference.const_mul mixingWeight)
  rw [rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedFlowDivergence_eq]
  simpa only [rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue] using!
    hDerivative

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- At every nonnegative time the reference-evolution density remains exactly normalized. -/
theorem sum_rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (time : ℝ) (hTime : 0 ≤ time) :
    ∑ state, rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
      generator path time state = 1 := by
  unfold rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
  rw [← ENNReal.toReal_sum]
  · rw [sum_finiteStateTimeDependentMarkovEndpointProbability
      (rengerDirectionalFlowHybridBVTargetInitialPMF path)
      generator.toTimeDependentMarkovRate time hTime]
    norm_num
  · intro state _hState
    have hCoordinate :
        finiteStateTimeDependentMarkovEndpointProbability
            (rengerDirectionalFlowHybridBVTargetInitialPMF path)
            generator.toTimeDependentMarkovRate time state ≤ 1 := by
      have hSingle := Finset.single_le_sum
        (s := Finset.univ)
        (f := fun observed : State ↦
          finiteStateTimeDependentMarkovEndpointProbability
            (rengerDirectionalFlowHybridBVTargetInitialPMF path)
            generator.toTimeDependentMarkovRate time observed)
        (fun observed _hObserved ↦ zero_le (a :=
          finiteStateTimeDependentMarkovEndpointProbability
            (rengerDirectionalFlowHybridBVTargetInitialPMF path)
            generator.toTimeDependentMarkovRate time observed))
        (Finset.mem_univ state)
      rwa [sum_finiteStateTimeDependentMarkovEndpointProbability
        (rengerDirectionalFlowHybridBVTargetInitialPMF path)
        generator.toTimeDependentMarkovRate time hTime] at hSingle
    exact ne_top_of_le_ne_top ENNReal.one_ne_top hCoordinate

omit [MeasurableSpace State] [MeasurableSingletonClass State] in
/-- Convex mixing preserves pointwise density normalization. -/
theorem sum_rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
    (generator : FiniteStateMarkovGenerator State)
    {hDuration : 0 < duration}
    (path : RengerDirectionalFlowHybridBVRepresentationPath State duration hDuration)
    (mixingWeight time : ℝ) (hTime : 0 ≤ time)
    (hTargetNormalized :
      ∑ state, rengerDirectionalFlowHybridBVDensityValue path.1 time state = 1) :
    ∑ state,
        rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue
          generator path mixingWeight time state = 1 := by
  simp_rw [rengerDirectionalFlowHybridBVReferenceEvolutionPerturbedDensityValue,
    Finset.sum_add_distrib, ← Finset.mul_sum]
  rw [hTargetNormalized,
    sum_rengerDirectionalFlowHybridBVReferenceEvolutionDensityValue
      generator path time hTime]
  ring

end

end FiniteMarkovProcesses.InformationTheory
