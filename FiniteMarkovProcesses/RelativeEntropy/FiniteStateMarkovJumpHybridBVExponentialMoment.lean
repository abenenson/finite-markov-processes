module
public import
  FiniteMarkovProcesses.RelativeEntropy.FiniteStateMarkovJumpHybridBVDualEvaluation
public import FiniteMarkovProcesses.RelativeEntropy.FiniteStateMarkovJumpHybridBVTilt
public import FiniteMarkovProcesses.Probability.FiniteStateMarkovExponentialTimeTiltHistoryDensity
public import
  FiniteMarkovProcesses.Probability.FiniteJumpHistoryExplicitHybridBVObservationMeasurability

/-!
# Microscopic exponential moments for hybrid-BV jump tests

This module specializes the source-neutral exponential time-tilt score to the continuous
directional-flow tests used by the finite-state hybrid-BV dynamic rate.  The resulting microscopic
evaluation is division-free and therefore remains well-defined on zero-rate directed edges.

The theorem here is the one-history probability input.  Identification of the replica average
with the macroscopic hybrid-BV dual evaluation is a separate representation theorem.

## Main results

- `rengerDirectionalFlowDualTestTransitionExponent_continuous`: continuity of every exponent row.
- `rengerDirectionalFlowMicroscopicDualEvaluation`: the exact one-history tested score.
- `lintegral_exp_rengerDirectionalFlowMicroscopicDualEvaluation_le_one`: microscopic exponential
  supermartingale bound.
- `rengerDirectionalFlowHybridBVFlowDerivativePairing_eq_averageJumpScore`: exact replica-average
  identification of the time-odd jump-test sector.
- `rengerDirectionalFlowHybridBVDualEvaluation_eq_averageMicroscopicDualEvaluation`: exact
  identification of the complete macroscopic dual evaluation with the replica-average
  microscopic exponential-tilt score.
-/

@[expose] public section

namespace FiniteMarkovProcesses.InformationTheory

open MeasureTheory
open scoped ENNReal

open FiniteMarkovProcesses.Probability
open PositiveFiniteJumpHistoryReplicas

universe u

noncomputable section

variable {State : Type u} [Fintype State] [DecidableEq State]
  {duration : ℝ}

/-- Every state-pair exponent induced by a hybrid-BV directional-flow test is continuous in
physical time, including the literal zero diagonal. -/
theorem rengerDirectionalFlowDualTestTransitionExponent_continuous
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (source target : State) :
    Continuous fun time ↦
      (rengerDirectionalFlowDualTestTransitionExponent test).exponent
        time source target := by
  by_cases hNe : source ≠ target
  · simpa [rengerDirectionalFlowDualTestTransitionExponent, hNe] using
      (test ⟨(source, target), hNe⟩).1.continuous
  · have hEq : source = target := not_ne_iff.mp hNe
    subst target
    simpa [rengerDirectionalFlowDualTestTransitionExponent] using
      (continuous_const : Continuous fun _time : ℝ ↦ (0 : ℝ))

/-- One-history directional-flow test evaluation: tested genuine jumps minus the change in
integrated escape generated by the same exponential rate tilt. -/
noncomputable def rengerDirectionalFlowMicroscopicDualEvaluation
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration) :
    FiniteJumpHistory State → ℝ :=
  finiteStateMarkovExponentialTimeTiltHistoryScore generator
    (rengerDirectionalFlowDualTestTransitionExponent test) duration

/-- The one-history directional-flow evaluation is measurable on the complete finite-history
carrier. -/
theorem measurable_rengerDirectionalFlowMicroscopicDualEvaluation
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration) :
    Measurable (rengerDirectionalFlowMicroscopicDualEvaluation generator test) :=
  measurable_finiteStateMarkovExponentialTimeTiltHistoryScore generator
    (rengerDirectionalFlowDualTestTransitionExponent test) duration

/-- The exponential of one microscopic directional-flow test evaluation has expectation at most
one under the normalized homogeneous physical jump law. -/
theorem lintegral_exp_rengerDirectionalFlowMicroscopicDualEvaluation_le_one
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (initial : PMF State) (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (hDuration : 0 ≤ duration) :
    ∫⁻ history, ENNReal.ofReal
        (Real.exp (rengerDirectionalFlowMicroscopicDualEvaluation
          generator test history))
      ∂finiteStateMarkovJumpDensityMeasure initial generator duration ≤ 1 := by
  exact lintegral_finiteStateMarkovExponentialTimeTiltHistoryExponential_le_one
    initial generator (rengerDirectionalFlowDualTestTransitionExponent test) hDuration

/-- The Hamiltonian weights on all channels leaving one state sum to that state's exponential
tilt escape difference. -/
theorem sum_outgoing_rengerDirectionalFlowHamiltonianWeight_eq_escapeDifference
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (time : ℝ) (source : State) :
    (∑ target : {target : State // target ≠ source},
      (generator.rate source target : ℝ) *
        rengerDirectionalFlowHybridBVHamiltonianWeight
          (test ⟨(source, target), target.property.symm⟩) time) =
      finiteStateMarkovExponentialTimeTiltEscapeDifference generator
        (rengerDirectionalFlowDualTestTransitionExponent test) time source := by
  rw [finiteStateMarkovExponentialTimeTiltEscapeDifference_eq_sum]
  rw [Finset.sum_subtype (s := Finset.univ.erase source)
    (p := fun target : State => target ≠ source) (by intro target; simp)]
  apply Finset.sum_congr rfl
  intro target _hTarget
  simp [rengerDirectionalFlowHybridBVHamiltonianWeight_apply,
    rengerDirectionalFlowDualTestTransitionExponent, target.property.symm]

/-- Weighting every ordered channel by membership in one occupied source state collapses the
finite Hamiltonian sum to that state's escape difference. -/
theorem sum_rengerDirectionalFlowHamiltonianWeight_mul_stateMembershipIndicator_eq_escapeDifference
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (time : ℝ) (occupied : State) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      (generator.rate transition.1.1 transition.1.2 : ℝ) *
        (rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time *
          FiniteJumpHistory.stateMembershipIndicator occupied transition.1.1)) =
      finiteStateMarkovExponentialTimeTiltEscapeDifference generator
        (rengerDirectionalFlowDualTestTransitionExponent test) time occupied := by
  rw [← sum_outgoingTransition_eq_sum_orderedOffDiagonalTransition]
  rw [Finset.sum_eq_single occupied]
  · simpa [FiniteJumpHistory.stateMembershipIndicator] using
      sum_outgoing_rengerDirectionalFlowHamiltonianWeight_eq_escapeDifference
        generator test time occupied
  · intro source _hSource hSource
    have hNe : occupied ≠ source := Ne.symm hSource
    simp [FiniteJumpHistory.stateMembershipIndicator, hNe]
  · simp

/-- The same fixed-state Hamiltonian collapse after integration on any oriented interval. -/
theorem sum_rengerHamiltonianInterval_mul_stateIndicator_eq_escapeIntegral
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (lower upper : ℝ) (occupied : State) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      (generator.rate transition.1.1 transition.1.2 : ℝ) *
        (FiniteJumpHistory.stateMembershipIndicator occupied transition.1.1 *
          ∫ time in lower..upper,
            rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time)) =
      ∫ time in lower..upper,
        finiteStateMarkovExponentialTimeTiltEscapeDifference generator
          (rengerDirectionalFlowDualTestTransitionExponent test) time occupied := by
  calc
    _ = ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
        ∫ time in lower..upper,
          (generator.rate transition.1.1 transition.1.2 : ℝ) *
            (rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time *
              FiniteJumpHistory.stateMembershipIndicator occupied transition.1.1) := by
      apply Finset.sum_congr rfl
      intro transition _hTransition
      rw [intervalIntegral.integral_const_mul]
      rw [intervalIntegral.integral_mul_const]
      ring
    _ = ∫ time in lower..upper,
        ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
          (generator.rate transition.1.1 transition.1.2 : ℝ) *
            (rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time *
              FiniteJumpHistory.stateMembershipIndicator occupied transition.1.1) := by
      rw [intervalIntegral.integral_finsetSum]
      intro transition _hTransition
      exact (continuous_const.mul
        ((rengerDirectionalFlowHybridBVHamiltonianWeight
          (test transition)).continuous.mul continuous_const)).intervalIntegrable lower upper
    _ = _ := by
      apply intervalIntegral.integral_congr
      intro time _hTime
      simpa only [] using
        sum_rengerDirectionalFlowHamiltonianWeight_mul_stateMembershipIndicator_eq_escapeDifference
          generator test time occupied

/-- The density increment of one microscopic event pairs with all channel Hamiltonian tails as
the normalized change between the post-event and pre-event escape rows. -/
theorem sum_rengerHamiltonianInterval_mul_eventDensityIncrement_eq_escapeDifferenceIntegral
    (successorIndex : ℕ) (history : FiniteJumpHistory State)
    (index : Fin history.jumpCount)
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (lower upper : ℝ) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      (generator.rate transition.1.1 transition.1.2 : ℝ) *
        (PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement
            successorIndex history index (Sum.inl transition.1.1) *
          ∫ time in lower..upper,
            rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time)) =
      (∫ time in lower..upper,
        (finiteStateMarkovExponentialTimeTiltEscapeDifference generator
            (rengerDirectionalFlowDualTestTransitionExponent test)
            time (history.states index.succ) -
          finiteStateMarkovExponentialTimeTiltEscapeDifference generator
            (rengerDirectionalFlowDualTestTransitionExponent test)
            time (history.states index.castSucc))) /
        (successorIndex + 1 : ℝ) := by
  calc
    _ = ((∑ transition : FiniteStateOrderedOffDiagonalTransition State,
          (generator.rate transition.1.1 transition.1.2 : ℝ) *
            (FiniteJumpHistory.stateMembershipIndicator
                (history.states index.succ) transition.1.1 *
              ∫ time in lower..upper,
                rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time)) -
        (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
          (generator.rate transition.1.1 transition.1.2 : ℝ) *
            (FiniteJumpHistory.stateMembershipIndicator
                (history.states index.castSucc) transition.1.1 *
              ∫ time in lower..upper,
                rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time))) /
          (successorIndex + 1 : ℝ) := by
      rw [← Finset.sum_sub_distrib]
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro transition _hTransition
      simp only [
        PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement]
      ring
    _ = ((∫ time in lower..upper,
          finiteStateMarkovExponentialTimeTiltEscapeDifference generator
            (rengerDirectionalFlowDualTestTransitionExponent test)
            time (history.states index.succ)) -
        (∫ time in lower..upper,
          finiteStateMarkovExponentialTimeTiltEscapeDifference generator
            (rengerDirectionalFlowDualTestTransitionExponent test)
            time (history.states index.castSucc))) /
          (successorIndex + 1 : ℝ) := by
      rw [
        sum_rengerHamiltonianInterval_mul_stateIndicator_eq_escapeIntegral,
        sum_rengerHamiltonianInterval_mul_stateIndicator_eq_escapeIntegral]
    _ = _ := by
      have hPost := (continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
          generator (rengerDirectionalFlowDualTestTransitionExponent test)
          (rengerDirectionalFlowDualTestTransitionExponent_continuous test)
          (history.states index.succ)).intervalIntegrable (μ := volume) lower upper
      have hPre := (continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
          generator (rengerDirectionalFlowDualTestTransitionExponent test)
          (rengerDirectionalFlowDualTestTransitionExponent_continuous test)
          (history.states index.castSucc)).intervalIntegrable (μ := volume) lower upper
      rw [intervalIntegral.integral_sub hPost hPre]

/-- The empirical initial-density Hamiltonian term is the particle average of the initial-row
escape-difference integrals. -/
theorem sum_rengerHamiltonianInterval_mul_empiricalInitialDensity_eq_averageEscapeIntegral
    (successorIndex : ℕ)
    (histories : PositiveFiniteJumpHistoryReplicas State successorIndex)
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      (generator.rate transition.1.1 transition.1.2 : ℝ) *
        (PositiveFiniteJumpHistoryReplicas.empiricalInitialDensity
            successorIndex histories transition.1.1 *
          ∫ time in 0..duration,
            rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time)) =
      (∑ replica,
        ∫ time in 0..duration,
          finiteStateMarkovExponentialTimeTiltEscapeDifference generator
            (rengerDirectionalFlowDualTestTransitionExponent test)
            time (histories replica).initialState) /
        (successorIndex + 1 : ℝ) := by
  calc
    _ = ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
        (∑ replica,
          (generator.rate transition.1.1 transition.1.2 : ℝ) *
            (FiniteJumpHistory.stateMembershipIndicator
                (histories replica).initialState transition.1.1 *
              ∫ time in 0..duration,
                rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time)) /
          (successorIndex + 1 : ℝ) := by
      unfold PositiveFiniteJumpHistoryReplicas.empiricalInitialDensity
      apply Finset.sum_congr rfl
      intro transition _hTransition
      rw [Finset.sum_div]
      rw [Finset.sum_div]
      rw [Finset.sum_mul]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro replica _hReplica
      ring
    _ = (∑ replica, ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
          (generator.rate transition.1.1 transition.1.2 : ℝ) *
            (FiniteJumpHistory.stateMembershipIndicator
                (histories replica).initialState transition.1.1 *
              ∫ time in 0..duration,
                rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time)) /
          (successorIndex + 1 : ℝ) := by
      rw [← Finset.sum_div]
      rw [Finset.sum_comm]
    _ = _ := by
      apply congrArg (fun value : ℝ => value / (successorIndex + 1 : ℝ))
      apply Finset.sum_congr rfl
      intro replica _hReplica
      rw [
        sum_rengerHamiltonianInterval_mul_stateIndicator_eq_escapeIntegral]

/-- On the ordered replica carrier, the full density Hamiltonian compensator is exactly the
particle average of the microscopic exponential-tilt escape corrections. -/
theorem rengerDirectionalFlowHybridBVDensityCompensator_eq_averageEscapeCorrection
    (successorIndex : ℕ) (duration : ℝ)
    (histories : OrderedPositiveFiniteJumpHistoryReplicas
      State successorIndex duration)
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (hDuration : 0 ≤ duration) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      (generator.rate transition.1.1 transition.1.2 : ℝ) *
        finiteIntervalL1PathWeightedCoordinateIntegral
          (rengerDirectionalFlowHybridBVHamiltonianWeight (test transition))
          (Sum.inl transition.1.1)
          (orderedEmpiricalDensityDirectionalFlowExplicitHybridBVObservation
            successorIndex duration histories).toDerivativePath.toL1Path) =
      (∑ replica,
        finiteStateMarkovExponentialTimeTiltEscapeCorrection generator
          (rengerDirectionalFlowDualTestTransitionExponent test) duration
          (orderedReplicaHistories successorIndex duration histories replica).states
          (orderedReplicaHistories successorIndex duration histories replica).jumpTimes) /
        (successorIndex + 1 : ℝ) := by
  let rawHistories := orderedReplicaHistories successorIndex duration histories
  rw [orderedEmpiricalDensityDirectionalFlowExplicitHybridBVObservation,
    empiricalDensityDirectionalFlowExplicitHybridBVPath_toL1Path]
  change (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      (generator.rate transition.1.1 transition.1.2 : ℝ) *
        finiteIntervalL1PathWeightedCoordinateIntegral
          (rengerDirectionalFlowHybridBVHamiltonianWeight (test transition))
          (Sum.inl transition.1.1)
          (empiricalDensityDirectionalFlowExplicitL1Path
            successorIndex rawHistories duration)) = _
  calc
    _ = ∑ transition : FiniteStateOrderedOffDiagonalTransition State,
        (generator.rate transition.1.1 transition.1.2 : ℝ) *
          (empiricalInitialDensity
                successorIndex rawHistories transition.1.1 *
              (∫ time in 0..duration,
                rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time) +
            ∑ event : EmpiricalDensityDirectionalFlowEventIndex
                successorIndex rawHistories,
              empiricalDensityDirectionalFlowEventIncrement
                  successorIndex (rawHistories event.1) event.2 (Sum.inl transition.1.1) *
                ∫ time in (rawHistories event.1).jumpTimes event.2..duration,
                  rengerDirectionalFlowHybridBVHamiltonianWeight
                    (test transition) time) := by
      apply Finset.sum_congr rfl
      intro transition _hTransition
      unfold empiricalDensityDirectionalFlowExplicitL1Path
      rw [map_add, finiteCoordinateVectorEventStepL1PathSum, map_sum]
      rw [finiteIntervalL1PathWeightedCoordinateIntegral_constant _ _ _ hDuration]
      rw [empiricalDensityDirectionalFlowInitialL1Value_density]
      apply congrArg (fun eventSum : ℝ =>
        (generator.rate transition.1.1 transition.1.2 : ℝ) *
          (empiricalInitialDensity
                successorIndex rawHistories transition.1.1 *
              (∫ time in 0..duration,
                rengerDirectionalFlowHybridBVHamiltonianWeight (test transition) time) +
            eventSum))
      apply Finset.sum_congr rfl
      intro event _hEvent
      rw [finiteIntervalL1PathWeightedCoordinateIntegral_vectorRightEventStep]
      · rw [empiricalDensityDirectionalFlowEventIncrementL1Value_apply]
      · exact (histories event.1).property.1 event.2
    _ = (∑ replica,
        finiteStateMarkovExponentialTimeTiltEscapeCorrection generator
          (rengerDirectionalFlowDualTestTransitionExponent test) duration
          (rawHistories replica).states (rawHistories replica).jumpTimes) /
        (successorIndex + 1 : ℝ) := by
      simp_rw [mul_add]
      rw [Finset.sum_add_distrib]
      rw [
        sum_rengerHamiltonianInterval_mul_empiricalInitialDensity_eq_averageEscapeIntegral]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      simp_rw [
        sum_rengerHamiltonianInterval_mul_eventDensityIncrement_eq_escapeDifferenceIntegral]
      simp only [Fintype.sum_sigma]
      let initialEscape := fun replica : Fin (successorIndex + 1) =>
        ∫ time in 0..duration,
          finiteStateMarkovExponentialTimeTiltEscapeDifference generator
            (rengerDirectionalFlowDualTestTransitionExponent test)
            time (rawHistories replica).initialState
      let eventEscape := fun (replica : Fin (successorIndex + 1))
          (index : Fin (rawHistories replica).jumpCount) =>
        ∫ time in (rawHistories replica).jumpTimes index..duration,
          (finiteStateMarkovExponentialTimeTiltEscapeDifference generator
              (rengerDirectionalFlowDualTestTransitionExponent test)
              time ((rawHistories replica).states index.succ) -
            finiteStateMarkovExponentialTimeTiltEscapeDifference generator
              (rengerDirectionalFlowDualTestTransitionExponent test)
              time ((rawHistories replica).states index.castSucc))
      change (∑ replica, initialEscape replica) / (successorIndex + 1 : ℝ) +
          (∑ replica, ∑ index, eventEscape replica index /
            (successorIndex + 1 : ℝ)) =
        (∑ replica,
          finiteStateMarkovExponentialTimeTiltEscapeCorrection generator
            (rengerDirectionalFlowDualTestTransitionExponent test) duration
            (rawHistories replica).states (rawHistories replica).jumpTimes) /
          (successorIndex + 1 : ℝ)
      have hEventDivision :
          (∑ replica, ∑ index, eventEscape replica index /
            (successorIndex + 1 : ℝ)) =
          (∑ replica, ∑ index, eventEscape replica index) /
            (successorIndex + 1 : ℝ) := by
        rw [Finset.sum_div]
        apply Finset.sum_congr rfl
        intro replica _hReplica
        rw [Finset.sum_div]
      rw [hEventDivision, ← add_div, ← Finset.sum_add_distrib]
      apply congrArg (fun value : ℝ => value / (successorIndex + 1 : ℝ))
      apply Finset.sum_congr rfl
      intro replica _hReplica
      rw [finiteStateMarkovExponentialTimeTiltEscapeCorrection_eq_initial_add_eventTails
        generator (rengerDirectionalFlowDualTestTransitionExponent test)
        (rengerDirectionalFlowDualTestTransitionExponent_continuous test)]
      rfl

/-- Summing one microscopic event's normalized ordered-flow increments against every channel test
recovers its full state-pair transition exponent divided by particle count.  A self event gives
zero on both sides. -/
theorem sum_empiricalDensityDirectionalFlowEventIncrement_flow_mul_test
    (successorIndex : ℕ) (history : FiniteJumpHistory State)
    (index : Fin history.jumpCount)
    (test : RengerDirectionalFlowHybridBVDualTest State duration) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement
          successorIndex history index (Sum.inr transition) *
        (test transition).1 (history.jumpTimes index)) =
      (rengerDirectionalFlowDualTestTransitionExponent test).exponent
          (history.jumpTimes index) (history.states index.castSucc)
          (history.states index.succ) /
        (successorIndex + 1 : ℝ) := by
  classical
  by_cases hTransition :
      history.states index.castSucc ≠ history.states index.succ
  · let matching : FiniteStateOrderedOffDiagonalTransition State :=
      ⟨(history.states index.castSucc, history.states index.succ), hTransition⟩
    rw [Finset.sum_eq_single matching]
    · simp [PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement,
        matching, rengerDirectionalFlowDualTestTransitionExponent, hTransition]
      rw [div_eq_mul_inv]
      ring
    · intro transition _hTransition hNotMatching
      have hDoesNotMatch :
          ¬(history.states index.castSucc = transition.val.1 ∧
            history.states index.succ = transition.val.2) := by
        rintro ⟨hSource, hTarget⟩
        apply hNotMatching
        apply Subtype.ext
        exact Prod.ext hSource.symm hTarget.symm
      simp [PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement,
        hDoesNotMatch]
    · simp
  · have hSelf : history.states index.castSucc = history.states index.succ :=
      not_ne_iff.mp hTransition
    have hNoMatch (transition : FiniteStateOrderedOffDiagonalTransition State) :
        ¬(history.states index.castSucc = transition.val.1 ∧
          history.states index.succ = transition.val.2) := by
      rintro ⟨hSource, hTarget⟩
      exact transition.property (hSource.symm.trans (hSelf.trans hTarget))
    rw [show (rengerDirectionalFlowDualTestTransitionExponent test).exponent
        (history.jumpTimes index) (history.states index.castSucc)
        (history.states index.succ) = 0 by
      simp [rengerDirectionalFlowDualTestTransitionExponent, hSelf], zero_div]
    apply Finset.sum_eq_zero
    intro transition _hTransition
    rw [show PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement
        successorIndex history index (Sum.inr transition) = 0 by
      simp [PositiveFiniteJumpHistoryReplicas.empiricalDensityDirectionalFlowEventIncrement,
        hNoMatch transition]]
    simp

/-- On the ordered replica carrier, the complete directional-flow derivative pairing is exactly
the particle average of the microscopic tested-jump scores. -/
theorem rengerDirectionalFlowHybridBVFlowDerivativePairing_eq_averageJumpScore
    (successorIndex : ℕ) (duration : ℝ)
    (histories : OrderedPositiveFiniteJumpHistoryReplicas
      State successorIndex duration)
    (test : RengerDirectionalFlowHybridBVDualTest State duration) :
    (∑ transition : FiniteStateOrderedOffDiagonalTransition State,
      ((orderedEmpiricalDensityDirectionalFlowExplicitHybridBVObservation
          successorIndex duration histories).toDerivativePath.derivative
            (Sum.inr transition)).continuousTestIntegral (test transition).1) =
      (∑ replica, finiteStateMarkovExponentialTimeTiltJumpScore
        (rengerDirectionalFlowDualTestTransitionExponent test)
        (orderedReplicaHistories
          successorIndex duration histories replica).states
        (orderedReplicaHistories
          successorIndex duration histories replica).jumpTimes) /
        (successorIndex + 1 : ℝ) := by
  simp_rw [orderedEmpiricalDensityDirectionalFlowExplicitHybridBVObservation_derivative,
    empiricalDensityDirectionalFlowFullDerivative_eq_finiteWeighted,
    finiteWeightedDiracVagueSignedMeasure_continuousTestIntegral]
  rw [Finset.sum_comm]
  simp only [Fintype.sum_sigma]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro replica _hReplica
  unfold finiteStateMarkovExponentialTimeTiltJumpScore
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro index _hIndex
  rw [← sum_empiricalDensityDirectionalFlowEventIncrement_flow_mul_test
    successorIndex]

/-- On the ordered replica carrier, the complete macroscopic hybrid-BV dual evaluation is exactly
the particle average of the microscopic exponential-tilt scores. -/
theorem rengerDirectionalFlowHybridBVDualEvaluation_eq_averageMicroscopicDualEvaluation
    (successorIndex : ℕ) (duration : ℝ)
    (histories : OrderedPositiveFiniteJumpHistoryReplicas
      State successorIndex duration)
    (generator : FiniteStateMarkovGenerator State)
    (test : RengerDirectionalFlowHybridBVDualTest State duration)
    (hDuration : 0 ≤ duration) :
    rengerDirectionalFlowHybridBVDualEvaluation generator test
        (orderedEmpiricalDensityDirectionalFlowExplicitHybridBVObservation
          successorIndex duration histories) =
      (∑ replica, rengerDirectionalFlowMicroscopicDualEvaluation generator test
        (orderedReplicaHistories
          successorIndex duration histories replica)) /
        (successorIndex + 1 : ℝ) := by
  unfold rengerDirectionalFlowHybridBVDualEvaluation
  rw [Finset.sum_sub_distrib]
  rw [rengerDirectionalFlowHybridBVFlowDerivativePairing_eq_averageJumpScore]
  rw [rengerDirectionalFlowHybridBVDensityCompensator_eq_averageEscapeCorrection
    successorIndex duration histories generator test hDuration]
  rw [← sub_div]
  rw [← Finset.sum_sub_distrib]
  apply congrArg (fun value : ℝ => value / (successorIndex + 1 : ℝ))
  apply Finset.sum_congr rfl
  intro replica _hReplica
  change
    finiteStateMarkovExponentialTimeTiltJumpScore
        (rengerDirectionalFlowDualTestTransitionExponent test)
        (orderedReplicaHistories successorIndex duration histories replica).states
        (orderedReplicaHistories successorIndex duration histories replica).jumpTimes -
      finiteStateMarkovExponentialTimeTiltEscapeCorrection generator
        (rengerDirectionalFlowDualTestTransitionExponent test) duration
        (orderedReplicaHistories successorIndex duration histories replica).states
        (orderedReplicaHistories successorIndex duration histories replica).jumpTimes =
      rengerDirectionalFlowMicroscopicDualEvaluation generator test
        (orderedReplicaHistories successorIndex duration histories replica)
  unfold rengerDirectionalFlowMicroscopicDualEvaluation
    finiteStateMarkovExponentialTimeTiltHistoryScore
    finiteStateMarkovExponentialTimeTiltSliceScore
  rfl

end

end FiniteMarkovProcesses.InformationTheory
