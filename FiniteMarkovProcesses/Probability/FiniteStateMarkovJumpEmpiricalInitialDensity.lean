module
public import FiniteMarkovProcesses.Probability.FiniteIIDEmpiricalProbabilityDensity
public import FiniteMarkovProcesses.Probability.FiniteStateMarkovJumpInitialStateMarginal
public import FiniteMarkovProcesses.Probability.FiniteStateMarkovJumpPositiveReplicaFamily

/-!
# Empirical initial density of a positive Markov-jump replica family

This module reads the initial state of every complete jump history in the common positive-replica
carrier.  It proves that the resulting simplex-valued empirical initial density has exactly the
generic finite IID empirical law generated by the prospectively supplied initial PMF.  The
generator and duration therefore introduce no hidden initial-law correction.

No large-deviation bound or hybrid-path initial-trace identification is asserted here.

## Main declarations

- `positiveFiniteJumpHistoryReplicaInitialStates`: initial states of one positive replica slice.
- `finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation`: common-carrier empirical
  initial-density observation.
- `finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw_eq_finiteIID`: exact identification
  with the generic IID empirical-density law.
-/

@[expose] public section

namespace FiniteMarkovProcesses.Probability

open MeasureTheory

open FiniteMarkovProcesses.InformationTheory

universe u

noncomputable section

variable {State : Type u} [Fintype State] [MeasurableSpace State]
  [MeasurableSingletonClass State] [DecidableEq State]

/-- Initial states read coordinatewise from one positive family of complete jump histories. -/
def positiveFiniteJumpHistoryReplicaInitialStates (successorIndex : ℕ)
    (histories : PositiveFiniteJumpHistoryReplicas State successorIndex) :
    Fin (successorIndex + 1) → State :=
  fun replica => (histories replica).initialState

omit [Fintype State] [MeasurableSingletonClass State] [DecidableEq State] in
/-- Reading every initial-state coordinate of a positive replica slice is measurable. -/
theorem measurable_positiveFiniteJumpHistoryReplicaInitialStates (successorIndex : ℕ) :
    Measurable
      (positiveFiniteJumpHistoryReplicaInitialStates
        (State := State) successorIndex) := by
  apply Measurable.of_eval
  intro replica
  exact FiniteJumpHistory.measurable_initialState.comp (measurable_pi_apply replica)

omit [DecidableEq State] in
/-- Under the normalized Markov-jump replica law, the complete histories' initial states have the
exact positive finite IID law supplied prospectively by `initial`. -/
theorem map_positiveFiniteJumpHistoryReplicaInitialStates
    (successorIndex : ℕ) (initial : PMF State)
    (generator : FiniteStateMarkovGenerator State) (duration : ℝ)
    (hDuration : 0 ≤ duration)
    (hNormalized : FiniteStateMarkovJumpDensityIsNormalized initial generator duration) :
    Measure.map
        (positiveFiniteJumpHistoryReplicaInitialStates successorIndex)
        (finiteStateMarkovJumpReplicaProbabilityMeasure
          (successorIndex + 1) initial generator duration hNormalized).toMeasure =
      finiteIIDPositiveSampleLaw successorIndex initial := by
  have : IsProbabilityMeasure
      (finiteStateMarkovJumpDensityMeasure initial generator duration) :=
    ⟨hNormalized⟩
  have : ∀ _ : Fin (successorIndex + 1),
      IsProbabilityMeasure
        (Measure.map FiniteJumpHistory.initialState
          (finiteStateMarkovJumpDensityMeasure initial generator duration)) :=
    fun _ => (Measure.isProbabilityMeasure_map_iff
      (μ := finiteStateMarkovJumpDensityMeasure initial generator duration)
      (f := FiniteJumpHistory.initialState)
      FiniteJumpHistory.measurable_initialState.aemeasurable).2 inferInstance
  rw [finiteStateMarkovJumpReplicaProbabilityMeasure_toMeasure]
  unfold finiteIIDPositiveSampleLaw
  unfold positiveFiniteJumpHistoryReplicaInitialStates
  rw [Measure.pi_map_pi fun _ =>
    FiniteJumpHistory.measurable_initialState.aemeasurable]
  congr 1
  funext replica
  exact finiteStateMarkovJumpDensityMeasureInitialStateMarginal
    initial generator duration hDuration

/-- Empirical initial probability density read from the complete histories on the common positive
replica carrier. -/
def finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation
    (family : FiniteStateMarkovJumpPositiveReplicaFamily State) :
    FiniteStateProbabilityDensity State :=
  finiteIIDEmpiricalProbabilityDensity family.1
    (positiveFiniteJumpHistoryReplicaInitialStates family.1 family.2)

/-- The common-carrier empirical initial-density observation is measurable. -/
theorem measurable_finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation :
    Measurable
      (finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation
        (State := State)) := by
  rw [measurable_sigma_iff]
  intro successorIndex
  exact (measurable_finiteIIDEmpiricalProbabilityDensity successorIndex).comp
    (measurable_positiveFiniteJumpHistoryReplicaInitialStates successorIndex)

/-- Law of the empirical initial probability density read from one positive Markov-jump replica
family slice. -/
def finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw
    (successorIndex : ℕ) (initial : PMF State)
    (generator : FiniteStateMarkovGenerator State) (duration : ℝ)
    (hNormalized : FiniteStateMarkovJumpDensityIsNormalized initial generator duration) :
    Measure (FiniteStateProbabilityDensity State) :=
  Measure.map finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation
    (finiteStateMarkovJumpPositiveReplicaFamilyLaw
      successorIndex initial generator duration hNormalized)

/-- The Markov-jump common-carrier empirical initial-density law is exactly the generic IID
empirical-density law of the prospectively supplied initial PMF. -/
theorem finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw_eq_finiteIID
    (successorIndex : ℕ) (initial : PMF State)
    (generator : FiniteStateMarkovGenerator State) (duration : ℝ)
    (hDuration : 0 ≤ duration)
    (hNormalized : FiniteStateMarkovJumpDensityIsNormalized initial generator duration) :
    finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw
        successorIndex initial generator duration hNormalized =
      finiteIIDEmpiricalProbabilityDensityLaw successorIndex initial := by
  unfold finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw
    finiteStateMarkovJumpPositiveReplicaFamilyLaw
  rw [Measure.map_map
    measurable_finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation
    (measurable_finiteStateMarkovJumpPositiveReplicaFamilyInjection
      successorIndex)]
  change Measure.map
      (finiteIIDEmpiricalProbabilityDensity successorIndex ∘
        positiveFiniteJumpHistoryReplicaInitialStates successorIndex)
      (finiteStateMarkovJumpReplicaProbabilityMeasure
        (successorIndex + 1) initial generator duration hNormalized).toMeasure =
    _
  rw [← Measure.map_map
    (measurable_finiteIIDEmpiricalProbabilityDensity successorIndex)
    (measurable_positiveFiniteJumpHistoryReplicaInitialStates successorIndex)]
  rw [map_positiveFiniteJumpHistoryReplicaInitialStates
    successorIndex initial generator duration hDuration hNormalized]
  rfl

/-- Every Markov-jump empirical initial-density law is exactly normalized. -/
instance instIsProbabilityMeasureFiniteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw
    (successorIndex : ℕ) (initial : PMF State)
    (generator : FiniteStateMarkovGenerator State) (duration : ℝ)
    (hNormalized : FiniteStateMarkovJumpDensityIsNormalized initial generator duration) :
    IsProbabilityMeasure
      (finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw
        successorIndex initial generator duration hNormalized) := by
  have := finiteStateMarkovJumpPositiveReplicaFamilyLaw_isProbabilityMeasure
    successorIndex initial generator duration hNormalized
  unfold finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityLaw
  exact (Measure.isProbabilityMeasure_map_iff
    (μ := finiteStateMarkovJumpPositiveReplicaFamilyLaw
      successorIndex initial generator duration hNormalized)
    (f := finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation)
    measurable_finiteStateMarkovJumpPositiveReplicaFamilyInitialDensityObservation.aemeasurable).2
      inferInstance

end

end FiniteMarkovProcesses.Probability
