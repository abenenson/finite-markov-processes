import FiniteMarkovProcesses.Probability.FiniteStateMarkovExponentialTimeTilt
import FiniteMarkovProcesses.Probability.FiniteStateMarkovUniformizedDeletionDensity
import FiniteMarkovProcesses.Probability.FiniteStateTimeDependentMarkovSelfEventDeletion

/-!
# Reduced-history density under an exponential time tilt

This module identifies the reduced finite-state jump density generated by a time-dependent
exponential rate tilt.  The likelihood exponent is kept in its division-free form: the sum of
the transition exponents minus the change in integrated escape.  Thus the identity remains valid
when some physical rates vanish.

The finite-history identities retain zero rates and the original physical time interval.
Large-deviation limits are established in the separate hybrid-BV representation modules.

## Main results

- `finiteStateMarkovExponentialTimeTiltSliceScore`: division-free log-density score on one word.
- `finiteStateMarkovExponentialTimeTiltJumpSliceDensity`: exact fixed-word density tilt.
- `finiteStateMarkovExponentialTimeTiltHistoryScore`: the score on complete finite histories.
- `finiteStateMarkovExponentialTimeTiltJumpDensityMeasure`: the exact reduced-law density tilt.
- `lintegral_finiteStateMarkovExponentialTimeTiltHistoryExponential_eq_one`: exact microscopic
  exponential normalization.
- `lintegral_finiteStateMarkovExponentialTimeTiltHistoryExponential_le_one`: microscopic
  exponential supermartingale bound.
-/

namespace FiniteMarkovProcesses.Probability

open MeasureTheory
open scoped BigOperators ENNReal NNReal

universe u

variable {State : Type u} [Fintype State] [DecidableEq State]

/-- Sum of the time-dependent transition exponents along one retained physical state word. -/
noncomputable def finiteStateMarkovExponentialTimeTiltJumpScore
    (tilt : FiniteStateTransitionExponent State) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) (times : Fin eventCount → ℝ) : ℝ :=
  ∑ index : Fin eventCount,
    tilt.exponent (times index) (states index.castSucc) (states index.succ)

/-- Change in integrated escape between the exponentially tilted and original generators. -/
noncomputable def finiteStateMarkovExponentialTimeTiltEscapeCorrection
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (duration : ℝ)
    {eventCount : ℕ} (states : Fin (eventCount + 1) → State)
    (times : Fin eventCount → ℝ) : ℝ :=
  finiteStateTimeDependentMarkovIntegratedEscape
      (generator.exponentialTimeTilt tilt) duration states times -
    finiteStateMarkovIntegratedEscape generator duration states times

/-- Pointwise change in one escape row under an exponential time tilt. -/
noncomputable def finiteStateMarkovExponentialTimeTiltEscapeDifference
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (time : ℝ) (state : State) : ℝ :=
  ((generator.exponentialTimeTilt tilt).escapeRate time state : ℝ) -
    (generator.escapeRate state : ℝ)

/-- Division-free log-density score of the exponential rate tilt on one retained state word. -/
noncomputable def finiteStateMarkovExponentialTimeTiltSliceScore
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (duration : ℝ)
    {eventCount : ℕ} (states : Fin (eventCount + 1) → State)
    (times : Fin eventCount → ℝ) : ℝ :=
  finiteStateMarkovExponentialTimeTiltJumpScore tilt states times -
    finiteStateMarkovExponentialTimeTiltEscapeCorrection
      generator tilt duration states times

/-- Continuous transition exponents give continuous real-valued tilted escape rows. -/
theorem continuous_exponentialTimeTilt_escapeRate
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (hContinuousExponent : ∀ source target,
      Continuous fun time ↦ tilt.exponent time source target)
    (source : State) :
    Continuous fun time ↦
      ((generator.exponentialTimeTilt tilt).escapeRate time source : ℝ) := by
  simp only [generator.exponentialTimeTilt_escapeRate, NNReal.coe_sum, NNReal.coe_mul,
    FiniteStateTransitionExponent.coe_exponentialMultiplier]
  apply continuous_finsetSum
  intro target _hTarget
  exact continuous_const.mul
    (Real.continuous_exp.comp (hContinuousExponent source target))

/-- The escape-row difference is the finite Hamiltonian compensator sum over directed targets. -/
theorem finiteStateMarkovExponentialTimeTiltEscapeDifference_eq_sum
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (time : ℝ) (source : State) :
    finiteStateMarkovExponentialTimeTiltEscapeDifference generator tilt time source =
      ∑ target ∈ Finset.univ.erase source,
        (generator.rate source target : ℝ) *
          (Real.exp (tilt.exponent time source target) - 1) := by
  unfold finiteStateMarkovExponentialTimeTiltEscapeDifference
  rw [generator.exponentialTimeTilt_escapeRate]
  simp only [NNReal.coe_sum, NNReal.coe_mul,
    FiniteStateTransitionExponent.coe_exponentialMultiplier]
  rw [show (generator.escapeRate source : ℝ) =
      ∑ target ∈ Finset.univ.erase source,
        (generator.rate source target : ℝ) by
    norm_cast
    unfold FiniteStateMarkovGenerator.escapeRate
    rw [Finset.sum_erase (s := Finset.univ) (generator.rate_self source)]]
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro target _hTarget
  ring

/-- Continuous transition exponents give a continuous escape-row difference. -/
theorem continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (hContinuousExponent : ∀ source target,
      Continuous fun time ↦ tilt.exponent time source target)
    (state : State) :
    Continuous (finiteStateMarkovExponentialTimeTiltEscapeDifference
      generator tilt · state) :=
  (continuous_exponentialTimeTilt_escapeRate
    generator tilt hContinuousExponent state).sub continuous_const

/-- The complete escape correction is the sum of the pointwise escape-row difference integrated
over every retained-state dwell. -/
theorem finiteStateMarkovExponentialTimeTiltEscapeCorrection_eq_sum_integral
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (hContinuousExponent : ∀ source target,
      Continuous fun time ↦ tilt.exponent time source target)
    (duration : ℝ) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) (times : Fin eventCount → ℝ) :
    finiteStateMarkovExponentialTimeTiltEscapeCorrection
        generator tilt duration states times =
      ∑ block : Fin (eventCount + 1),
        ∫ time in
          (FiniteJumpHistory.boundaryTimeVector duration times block.castSucc)..
          (FiniteJumpHistory.boundaryTimeVector duration times block.succ),
            finiteStateMarkovExponentialTimeTiltEscapeDifference
              generator tilt time (states block) := by
  unfold finiteStateMarkovExponentialTimeTiltEscapeCorrection
    finiteStateTimeDependentMarkovIntegratedEscape finiteStateMarkovIntegratedEscape
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro block _hBlock
  let lower := FiniteJumpHistory.boundaryTimeVector duration times block.castSucc
  let upper := FiniteJumpHistory.boundaryTimeVector duration times block.succ
  have hStatic :
      (generator.escapeRate (states block) : ℝ) *
          FiniteJumpHistory.dwellTimeVector duration times block =
        ∫ _time in lower..upper,
          (generator.escapeRate (states block) : ℝ) := by
    unfold lower upper FiniteJumpHistory.dwellTimeVector
    rw [intervalIntegral.integral_const]
    simp only [smul_eq_mul]
    ring
  rw [hStatic]
  rw [← intervalIntegral.integral_sub]
  · rfl
  · exact (continuous_exponentialTimeTilt_escapeRate
      generator tilt hContinuousExponent (states block)).intervalIntegrable lower upper
  · exact intervalIntegrable_const

/-- The dwellwise escape correction is equivalently the initial-row integral plus the sum of
all post-event row-difference tail integrals.  This event-step form is the exact interface to the
empirical hybrid-BV density observation. -/
theorem finiteStateMarkovExponentialTimeTiltEscapeCorrection_eq_initial_add_eventTails
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (hContinuousExponent : ∀ source target,
      Continuous fun time ↦ tilt.exponent time source target)
    (duration : ℝ) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) (times : Fin eventCount → ℝ) :
    finiteStateMarkovExponentialTimeTiltEscapeCorrection
        generator tilt duration states times =
      (∫ time in 0..duration,
        finiteStateMarkovExponentialTimeTiltEscapeDifference
          generator tilt time (states 0)) +
      ∑ index : Fin eventCount,
        ∫ time in (times index)..duration,
          (finiteStateMarkovExponentialTimeTiltEscapeDifference
              generator tilt time (states index.succ) -
            finiteStateMarkovExponentialTimeTiltEscapeDifference
              generator tilt time (states index.castSucc)) := by
  rw [finiteStateMarkovExponentialTimeTiltEscapeCorrection_eq_sum_integral
    generator tilt hContinuousExponent]
  let primitive := fun state endpoint ↦
    ∫ time in 0..endpoint,
      finiteStateMarkovExponentialTimeTiltEscapeDifference generator tilt time state
  have hInterval (state : State) (lower upper : ℝ) :
      (∫ time in lower..upper,
        finiteStateMarkovExponentialTimeTiltEscapeDifference generator tilt time state) =
      primitive state upper - primitive state lower := by
    exact (intervalIntegral.integral_interval_sub_left
      ((continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
        generator tilt hContinuousExponent state).intervalIntegrable 0 upper)
      ((continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
        generator tilt hContinuousExponent state).intervalIntegrable 0 lower)).symm
  have hEventTail (index : Fin eventCount) :
      (∫ time in (times index)..duration,
        (finiteStateMarkovExponentialTimeTiltEscapeDifference
            generator tilt time (states index.succ) -
          finiteStateMarkovExponentialTimeTiltEscapeDifference
            generator tilt time (states index.castSucc))) =
        (primitive (states index.succ) duration -
            primitive (states index.succ) (times index)) -
          (primitive (states index.castSucc) duration -
            primitive (states index.castSucc) (times index)) := by
    rw [intervalIntegral.integral_sub]
    · rw [hInterval, hInterval]
    · exact (continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
        generator tilt hContinuousExponent (states index.succ)).intervalIntegrable
          (times index) duration
    · exact (continuous_finiteStateMarkovExponentialTimeTiltEscapeDifference
        generator tilt hContinuousExponent (states index.castSucc)).intervalIntegrable
          (times index) duration
  simp_rw [hInterval]
  simp_rw [hEventTail]
  simp_rw [Finset.sum_sub_distrib]
  have hTailAtDuration :
      primitive (states 0) duration +
          ((∑ index : Fin eventCount, primitive (states index.succ) duration) -
            ∑ index : Fin eventCount, primitive (states index.castSucc) duration) =
        primitive (states (Fin.last eventCount)) duration := by
    have hSucc := Fin.sum_univ_succ (fun block : Fin (eventCount + 1) ↦
      primitive (states block) duration)
    have hCast := Fin.sum_univ_castSucc (fun block : Fin (eventCount + 1) ↦
      primitive (states block) duration)
    linarith
  rw [Fin.sum_univ_castSucc (fun block : Fin (eventCount + 1) ↦
    primitive (states block)
      (FiniteJumpHistory.boundaryTimeVector duration times block.succ))]
  rw [Fin.sum_univ_succ (fun block : Fin (eventCount + 1) ↦
    primitive (states block)
      (FiniteJumpHistory.boundaryTimeVector duration times block.castSucc))]
  have hLastIndex :
      (Fin.last eventCount).succ = Fin.last (eventCount + 1) := rfl
  have hZeroIndex :
      (0 : Fin (eventCount + 1)).castSucc = (0 : Fin (eventCount + 2)) := rfl
  have hMiddleIndex (index : Fin eventCount) :
      index.succ.castSucc = index.castSucc.succ := rfl
  rw [hLastIndex, FiniteJumpHistory.boundaryTimeVector_last,
    hZeroIndex, FiniteJumpHistory.boundaryTimeVector_zero]
  simp_rw [hMiddleIndex, FiniteJumpHistory.boundaryTimeVector_succ_castSucc]
  rw [show primitive (states 0) 0 = 0 by simp [primitive]]
  linarith

omit [Fintype State] [DecidableEq State] in
/-- The transition-exponent sum is measurable in the retained jump times. -/
theorem measurable_finiteStateMarkovExponentialTimeTiltJumpScore
    (tilt : FiniteStateTransitionExponent State) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) :
    Measurable (finiteStateMarkovExponentialTimeTiltJumpScore tilt states) := by
  unfold finiteStateMarkovExponentialTimeTiltJumpScore
  apply Finset.measurable_sum
  intro index _hIndex
  exact (tilt.measurable_exponent
    (states index.castSucc) (states index.succ)).comp (measurable_pi_apply index)

/-- Measurable bounded transition exponents make the escape correction measurable in retained
times. -/
theorem measurable_finiteStateMarkovExponentialTimeTiltEscapeCorrection
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (duration : ℝ) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) :
    Measurable (finiteStateMarkovExponentialTimeTiltEscapeCorrection
      generator tilt duration states) := by
  unfold finiteStateMarkovExponentialTimeTiltEscapeCorrection
  exact (measurable_finiteStateTimeDependentMarkovIntegratedEscape
    (generator.exponentialTimeTilt tilt) duration states).sub
      (measurable_finiteStateMarkovIntegratedEscape generator duration states)

/-- Measurable bounded transition exponents make every fixed-word tilt score measurable. -/
theorem measurable_finiteStateMarkovExponentialTimeTiltSliceScore
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (duration : ℝ) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) :
    Measurable (finiteStateMarkovExponentialTimeTiltSliceScore
      generator tilt duration states) := by
  unfold finiteStateMarkovExponentialTimeTiltSliceScore
  exact (measurable_finiteStateMarkovExponentialTimeTiltJumpScore tilt states).sub
    (measurable_finiteStateMarkovExponentialTimeTiltEscapeCorrection
      generator tilt duration states)

/-- The tilted retained jump-rate product is the original product times the exponential of the
transition score. -/
theorem finiteStateMarkovExponentialTimeTiltJumpRateProduct
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) {eventCount : ℕ}
    (states : Fin (eventCount + 1) → State) (times : Fin eventCount → ℝ) :
    finiteStateTimeDependentMarkovJumpRateProduct
        (generator.exponentialTimeTilt tilt) states times =
      finiteStateMarkovJumpRateProduct generator states *
        Real.exp (finiteStateMarkovExponentialTimeTiltJumpScore tilt states times) := by
  unfold finiteStateTimeDependentMarkovJumpRateProduct finiteStateMarkovJumpRateProduct
    finiteStateMarkovExponentialTimeTiltJumpScore
  simp_rw [generator.coe_exponentialTimeTilt_rate]
  rw [Finset.prod_mul_distrib, ← Real.exp_sum]

/-- Exact division-free exponential-tilt identity for one reduced-history density slice. -/
theorem finiteStateMarkovExponentialTimeTiltJumpSliceDensity
    (initial : PMF State) (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (duration : ℝ)
    {eventCount : ℕ} (states : Fin (eventCount + 1) → State)
    (times : Fin eventCount → ℝ) :
    finiteStateTimeDependentMarkovJumpSliceDensity initial
        (generator.exponentialTimeTilt tilt) duration states times =
      finiteStateMarkovJumpSliceDensity initial generator duration states times *
        Real.exp (finiteStateMarkovExponentialTimeTiltSliceScore
          generator tilt duration states times) := by
  rw [finiteStateTimeDependentMarkovJumpSliceDensity,
    finiteStateMarkovJumpSliceDensity,
    finiteStateMarkovExponentialTimeTiltJumpRateProduct]
  unfold finiteStateMarkovExponentialTimeTiltSliceScore
    finiteStateMarkovExponentialTimeTiltEscapeCorrection
  rw [show -finiteStateTimeDependentMarkovIntegratedEscape
      (generator.exponentialTimeTilt tilt) duration states times =
      -finiteStateMarkovIntegratedEscape generator duration states times +
        (finiteStateMarkovIntegratedEscape generator duration states times -
          finiteStateTimeDependentMarkovIntegratedEscape
            (generator.exponentialTimeTilt tilt) duration states times) by ring,
    Real.exp_add,
    show finiteStateMarkovExponentialTimeTiltJumpScore tilt states times -
        (finiteStateTimeDependentMarkovIntegratedEscape
          (generator.exponentialTimeTilt tilt) duration states times -
            finiteStateMarkovIntegratedEscape generator duration states times) =
      finiteStateMarkovExponentialTimeTiltJumpScore tilt states times +
        (finiteStateMarkovIntegratedEscape generator duration states times -
          finiteStateTimeDependentMarkovIntegratedEscape
            (generator.exponentialTimeTilt tilt) duration states times) by ring,
    Real.exp_add]
  ring

/-- Division-free exponential-tilt score on a complete finite physical jump history. -/
noncomputable def finiteStateMarkovExponentialTimeTiltHistoryScore
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (duration : ℝ) :
    FiniteJumpHistory State → ℝ
  | ⟨_, states, times⟩ =>
      finiteStateMarkovExponentialTimeTiltSliceScore
        generator tilt duration states times

/-- Measurable bounded transition exponents make the complete-history tilt score measurable. -/
theorem measurable_finiteStateMarkovExponentialTimeTiltHistoryScore
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (duration : ℝ) :
    Measurable (finiteStateMarkovExponentialTimeTiltHistoryScore
      generator tilt duration) := by
  rw [measurable_sigma_iff]
  intro eventCount
  apply measurable_from_prod_countable_right
  intro states
  exact measurable_finiteStateMarkovExponentialTimeTiltSliceScore
    generator tilt duration states

/-- Extended-nonnegative exponential of the complete-history tilt score. -/
noncomputable def finiteStateMarkovExponentialTimeTiltHistoryExponential
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (duration : ℝ) :
    FiniteJumpHistory State → ℝ≥0∞ :=
  fun history ↦ ENNReal.ofReal
    (Real.exp (finiteStateMarkovExponentialTimeTiltHistoryScore
      generator tilt duration history))

/-- The complete-history exponential tilt weight is measurable. -/
theorem measurable_finiteStateMarkovExponentialTimeTiltHistoryExponential
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (duration : ℝ) :
    Measurable (finiteStateMarkovExponentialTimeTiltHistoryExponential
      generator tilt duration) :=
  ((measurable_finiteStateMarkovExponentialTimeTiltHistoryScore
    generator tilt duration).exp).ennreal_ofReal

/-- The complete-history weight restricts literally to the exponential fixed-word score. -/
@[simp]
theorem finiteStateMarkovExponentialTimeTiltHistoryExponential_embedJumpTimes
    [_unusedMeasurableSpace : MeasurableSpace State]
    (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State) (duration : ℝ)
    {eventCount : ℕ} (states : Fin (eventCount + 1) → State)
    (times : Fin eventCount → ℝ) :
    finiteStateMarkovExponentialTimeTiltHistoryExponential generator tilt duration
        (embedJumpTimes eventCount states times) =
      ENNReal.ofReal (Real.exp
        (finiteStateMarkovExponentialTimeTiltSliceScore
          generator tilt duration states times)) :=
  rfl

/-- On every fixed reduced word, the time-dependent tilted jump measure is exactly the original
physical word measure weighted by the complete-history exponential score. -/
theorem finiteStateMarkovExponentialTimeTiltJumpWordSliceMeasure
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (initial : PMF State) (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (duration : ℝ) (eventCount : ℕ)
    (states : Fin (eventCount + 1) → State) :
    finiteStateTimeDependentMarkovJumpWordSliceMeasure initial
        (generator.exponentialTimeTilt tilt) duration eventCount states =
      (finiteStateMarkovJumpWordSliceMeasure
        initial generator duration eventCount states).withDensity
          (finiteStateMarkovExponentialTimeTiltHistoryExponential
            generator tilt duration) := by
  let baseTimeMeasure := volume.restrict (orderedJumpTimes eventCount duration)
  let baseDensity := fun times : Fin eventCount → ℝ ↦
    ENNReal.ofReal
      (finiteStateMarkovJumpSliceDensity initial generator duration states times)
  let scoreWeight := finiteStateMarkovExponentialTimeTiltHistoryExponential
    generator tilt duration
  have hBaseDensity : Measurable baseDensity :=
    (measurable_finiteStateMarkovJumpSliceDensity
      initial generator duration states).ennreal_ofReal
  have hScoreWeight : Measurable scoreWeight :=
    measurable_finiteStateMarkovExponentialTimeTiltHistoryExponential
      generator tilt duration
  have hPulledScoreWeight : Measurable
      (scoreWeight ∘ embedJumpTimes eventCount states) :=
    hScoreWeight.comp (measurable_embedJumpTimes eventCount states)
  unfold finiteStateTimeDependentMarkovJumpWordSliceMeasure
    finiteStateMarkovJumpWordSliceMeasure
  rw [← Measure.map_withDensity_comp
    (baseTimeMeasure.withDensity baseDensity)
    (measurable_embedJumpTimes eventCount states) scoreWeight hScoreWeight]
  apply congrArg (Measure.map (embedJumpTimes eventCount states))
  rw [← withDensity_mul baseTimeMeasure hBaseDensity hPulledScoreWeight]
  apply congrArg baseTimeMeasure.withDensity
  funext times
  change ENNReal.ofReal
      (finiteStateTimeDependentMarkovJumpSliceDensity initial
        (generator.exponentialTimeTilt tilt) duration states times) =
    baseDensity times * scoreWeight (embedJumpTimes eventCount states times)
  rw [finiteStateMarkovExponentialTimeTiltJumpSliceDensity]
  exact ENNReal.ofReal_mul
    (finiteStateMarkovJumpSliceDensity_nonneg
      initial generator duration states times)

/-- The complete reduced time-dependent density is exactly the original physical history law
weighted by the complete-history exponential score. -/
theorem finiteStateMarkovExponentialTimeTiltJumpDensityMeasure
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (initial : PMF State) (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    (duration : ℝ) :
    finiteStateTimeDependentMarkovJumpDensityMeasure initial
        (generator.exponentialTimeTilt tilt) duration =
      (finiteStateMarkovJumpDensityMeasure initial generator duration).withDensity
        (finiteStateMarkovExponentialTimeTiltHistoryExponential
          generator tilt duration) := by
  rw [finiteStateMarkovJumpDensityMeasure_eq_sum_reducedWordSliceMeasures]
  unfold finiteStateTimeDependentMarkovJumpDensityMeasure
  rw [withDensity_sum]
  congr 1
  funext eventCount
  rw [withDensity_sum]
  congr 1
  funext reducedStates
  exact finiteStateMarkovExponentialTimeTiltJumpWordSliceMeasure
    initial generator tilt duration eventCount reducedStates.1

/-- The exponential of the complete-history tilt score has expectation exactly one under the
original normalized physical history law. -/
theorem lintegral_finiteStateMarkovExponentialTimeTiltHistoryExponential_eq_one
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (initial : PMF State) (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    {duration : ℝ} (hDuration : 0 ≤ duration) :
    ∫⁻ history,
        finiteStateMarkovExponentialTimeTiltHistoryExponential
          generator tilt duration history
      ∂finiteStateMarkovJumpDensityMeasure initial generator duration = 1 := by
  have hTiltedMass :=
    finiteStateTimeDependentMarkovJumpDensityMeasure_univ initial
      (generator.exponentialTimeTilt tilt) hDuration
  rw [finiteStateMarkovExponentialTimeTiltJumpDensityMeasure
      initial generator tilt duration,
    withDensity_apply _ MeasurableSet.univ, setLIntegral_univ] at hTiltedMass
  exact hTiltedMass

/-- The exact exponential normalization in particular supplies the microscopic exponential
supermartingale bound. -/
theorem lintegral_finiteStateMarkovExponentialTimeTiltHistoryExponential_le_one
    [MeasurableSpace State] [MeasurableSingletonClass State]
    (initial : PMF State) (generator : FiniteStateMarkovGenerator State)
    (tilt : FiniteStateTransitionExponent State)
    {duration : ℝ} (hDuration : 0 ≤ duration) :
    ∫⁻ history,
        finiteStateMarkovExponentialTimeTiltHistoryExponential
          generator tilt duration history
      ∂finiteStateMarkovJumpDensityMeasure initial generator duration ≤ 1 := by
  exact (lintegral_finiteStateMarkovExponentialTimeTiltHistoryExponential_eq_one
    initial generator tilt hDuration).le

end FiniteMarkovProcesses.Probability
