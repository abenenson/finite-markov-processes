import FiniteMarkovProcesses.Probability.FiniteStateTimeDependentMarkovUniformization
import Mathlib.Basic.Real.Sign

/-!
# Finite-state Markov L1 dissipation

The signed error flow generated by nonnegative transition rates is dissipative in the coordinate
`L1` sign pairing.  Diagonal rates may be included because their incoming and outgoing
contributions cancel identically.

This is the algebraic cancellation engine for total-variation stability of measurable-rate
finite-state forward equations.
-/

namespace FiniteMarkovProcesses.Probability

open scoped BigOperators NNReal

universe u

noncomputable section

variable {State : Type u} [Fintype State]

/-- Incoming-minus-outgoing divergence of an arbitrary real ordered flow.  Diagonal flow is
allowed because it cancels between the two sums. -/
noncomputable def finiteStateFlowDivergence
    (flow : State → State → ℝ) (state : State) : ℝ :=
  (∑ source, flow source state) - ∑ target, flow state target

/-- Incoming-minus-outgoing divergence of a signed state error transported by nonnegative rates.
Diagonal terms are harmless and cancel. -/
noncomputable def finiteStateRateErrorDivergence
    (rate : State → State → NNReal) (error : State → ℝ) (state : State) : ℝ :=
  (∑ source, error source * (rate source state : ℝ)) -
    error state * ∑ target, (rate state target : ℝ)

/-- One coordinate of a finite-state flow divergence is controlled by twice the complete
ordered-flow `L1` mass. -/
theorem abs_finiteStateFlowDivergence_le_two_mul_sum_abs
    (flow : State → State → ℝ) (state : State) :
    |finiteStateFlowDivergence flow state| ≤
      2 * ∑ source, ∑ target, |flow source target| := by
  have hIncoming :
      (∑ source, |flow source state|) ≤
        ∑ source, ∑ target, |flow source target| := by
    apply Finset.sum_le_sum
    intro source _hSource
    exact Finset.single_le_sum
      (fun target _hTarget ↦ abs_nonneg (flow source target))
      (Finset.mem_univ state)
  have hOutgoing :
      (∑ target, |flow state target|) ≤
        ∑ source, ∑ target, |flow source target| := by
    exact Finset.single_le_sum
      (fun source _hSource ↦ Finset.sum_nonneg fun target _hTarget ↦
        abs_nonneg (flow source target))
      (Finset.mem_univ state)
  calc
    |finiteStateFlowDivergence flow state| ≤
        |∑ source, flow source state| + |∑ target, flow state target| := by
      unfold finiteStateFlowDivergence
      exact abs_sub _ _
    _ ≤ (∑ source, |flow source state|) + ∑ target, |flow state target| :=
      add_le_add
        (Finset.abs_sum_le_sum_abs (fun source ↦ flow source state) Finset.univ)
        (Finset.abs_sum_le_sum_abs (flow state) Finset.univ)
    _ ≤ _ := by linarith

/-- Subtracting an arbitrary target-flow divergence from a rate-generated probability drift
splits exactly into transported state error plus the divergence of the target-flow defect. -/
theorem finiteStateFlowDivergence_probabilityRate_sub_targetFlow_eq
    (rate : State → State → NNReal)
    (probability targetDensity : State → ℝ)
    (targetFlow : State → State → ℝ) (state : State) :
    finiteStateFlowDivergence
          (fun source target ↦ probability source * (rate source target : ℝ)) state -
        finiteStateFlowDivergence targetFlow state =
      finiteStateRateErrorDivergence rate
          (fun observed ↦ probability observed - targetDensity observed) state +
        finiteStateFlowDivergence
          (fun source target ↦
            targetDensity source * (rate source target : ℝ) - targetFlow source target)
          state := by
  unfold finiteStateFlowDivergence finiteStateRateErrorDivergence
  simp_rw [sub_mul, Finset.sum_sub_distrib, Finset.mul_sum]
  ring

/-- One signed source coordinate contributes nonpositively when paired with the change of sign
between its target and source coordinates. -/
theorem mul_sign_sub_sign_nonpos (sourceError targetError : ℝ) :
    sourceError * (Real.sign targetError - Real.sign sourceError) ≤ 0 := by
  obtain hSource | rfl | hSource := lt_trichotomy sourceError 0
  · obtain hTarget | rfl | hTarget := lt_trichotomy targetError 0
    · rw [Real.sign_of_neg hSource, Real.sign_of_neg hTarget]
      simp
    · rw [Real.sign_zero, Real.sign_of_neg hSource]
      simpa using hSource.le
    · rw [Real.sign_of_neg hSource, Real.sign_of_pos hTarget]
      nlinarith
  · simp
  · obtain hTarget | rfl | hTarget := lt_trichotomy targetError 0
    · rw [Real.sign_of_pos hSource, Real.sign_of_neg hTarget]
      nlinarith
    · rw [Real.sign_zero, Real.sign_of_pos hSource]
      nlinarith
    · rw [Real.sign_of_pos hSource, Real.sign_of_pos hTarget]
      simp

/-- Pairing one arbitrary real flow defect with a difference of coordinate-error signs costs at
most twice the absolute defect. -/
theorem mul_sign_sub_sign_le_two_mul_abs
    (flow sourceError targetError : ℝ) :
    flow * (Real.sign targetError - Real.sign sourceError) ≤ 2 * |flow| := by
  rcases lt_trichotomy sourceError 0 with hSource | rfl | hSource <;>
    rcases lt_trichotomy targetError 0 with hTarget | rfl | hTarget
  all_goals simp_all only [Real.sign_of_neg, Real.sign_of_pos, Real.sign_zero]
  all_goals nlinarith [le_abs_self flow, neg_le_abs flow]

/-- The complete sign pairing of an arbitrary finite-state flow divergence is its ordered-pair
sum against the target-minus-source sign difference. -/
theorem sum_sign_mul_finiteStateFlowDivergence_eq
    (flow : State → State → ℝ) (error : State → ℝ) :
    (∑ state, Real.sign (error state) * finiteStateFlowDivergence flow state) =
      ∑ source, ∑ target,
        flow source target * (Real.sign (error target) - Real.sign (error source)) := by
  unfold finiteStateFlowDivergence
  simp_rw [mul_sub, Finset.mul_sum, Finset.sum_sub_distrib]
  rw [Finset.sum_comm]
  congr 1 <;>
    apply Finset.sum_congr rfl <;>
    intro source _hSource <;>
    apply Finset.sum_congr rfl <;>
    intro target _hTarget <;>
    ring

/-- The sign pairing of an arbitrary finite-state flow divergence is controlled without
any rate constant by twice the total absolute ordered-flow defect. -/
theorem sum_sign_mul_finiteStateFlowDivergence_le_two_mul_sum_abs
    (flow : State → State → ℝ) (error : State → ℝ) :
    (∑ state, Real.sign (error state) * finiteStateFlowDivergence flow state) ≤
      2 * ∑ source, ∑ target, |flow source target| := by
  rw [sum_sign_mul_finiteStateFlowDivergence_eq]
  calc
    (∑ source, ∑ target,
        flow source target * (Real.sign (error target) - Real.sign (error source))) ≤
        ∑ source, ∑ target, 2 * |flow source target| := by
      apply Finset.sum_le_sum
      intro source _hSource
      apply Finset.sum_le_sum
      intro target _hTarget
      exact mul_sign_sub_sign_le_two_mul_abs
        (flow source target) (error source) (error target)
    _ = 2 * ∑ source, ∑ target, |flow source target| := by
      simp_rw [Finset.mul_sum]

/-- The complete sign pairing of the finite-state error divergence is the ordered-pair sum of
source errors times their sign drop. -/
theorem sum_sign_mul_finiteStateRateErrorDivergence_eq
    (rate : State → State → NNReal) (error : State → ℝ) :
    (∑ state, Real.sign (error state) *
        finiteStateRateErrorDivergence rate error state) =
      ∑ source, ∑ target,
        (rate source target : ℝ) *
          (error source * (Real.sign (error target) - Real.sign (error source))) := by
  unfold finiteStateRateErrorDivergence
  simp_rw [mul_sub, Finset.mul_sum, Finset.sum_sub_distrib]
  rw [Finset.sum_comm]
  congr 1 <;>
    apply Finset.sum_congr rfl <;>
    intro source _hSource <;>
    apply Finset.sum_congr rfl <;>
    intro target _hTarget <;>
    ring

/-- Every nonnegative finite-state rate family is dissipative in the coordinate `L1` sign
pairing. -/
theorem sum_sign_mul_finiteStateRateErrorDivergence_nonpos
    (rate : State → State → NNReal) (error : State → ℝ) :
    (∑ state, Real.sign (error state) *
        finiteStateRateErrorDivergence rate error state) ≤ 0 := by
  rw [sum_sign_mul_finiteStateRateErrorDivergence_eq]
  apply Finset.sum_nonpos
  intro source _hSource
  apply Finset.sum_nonpos
  intro target _hTarget
  exact mul_nonpos_of_nonneg_of_nonpos
    (rate source target).coe_nonneg
    (mul_sign_sub_sign_nonpos (error source) (error target))

/-- Markov transport plus an arbitrary flow defect obeys the cutoff-independent `L1` sign
estimate: the generated rate term dissipates and only the explicit defect remains. -/
theorem sum_sign_mul_rateErrorDivergence_add_flowDivergence_le
    (rate : State → State → NNReal) (error : State → ℝ)
    (flowDefect : State → State → ℝ) :
    (∑ state, Real.sign (error state) *
        (finiteStateRateErrorDivergence rate error state +
          finiteStateFlowDivergence flowDefect state)) ≤
      2 * ∑ source, ∑ target, |flowDefect source target| := by
  simp_rw [mul_add, Finset.sum_add_distrib]
  linarith [sum_sign_mul_finiteStateRateErrorDivergence_nonpos rate error,
    sum_sign_mul_finiteStateFlowDivergence_le_two_mul_sum_abs flowDefect error]

/-- Pointwise specialization to a bounded measurable time-dependent Markov rate. -/
theorem FiniteStateTimeDependentMarkovRate.sum_sign_mul_errorDivergence_nonpos
    [DecidableEq State]
    (rates : FiniteStateTimeDependentMarkovRate State)
    (time : ℝ) (error : State → ℝ) :
    (∑ state, Real.sign (error state) *
        finiteStateRateErrorDivergence (rates.rate time) error state) ≤ 0 :=
  sum_sign_mul_finiteStateRateErrorDivergence_nonpos (rates.rate time) error

end

end FiniteMarkovProcesses.Probability
